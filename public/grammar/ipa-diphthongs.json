{"id":"ipa-diphthongs","group":"sounds","title":"Nguyên âm đôi","subtitle":"8 nguyên âm đôi: /eɪ/ /aɪ/ /ɔɪ/ /əʊ/…","theory":{"sounds":[{"symbol":"/aɪ/","examples":[{"word":"buy","ipa":"/baɪ/","meaning":"mua"},{"word":"time","ipa":"/taɪm/","meaning":"thời gian"},{"word":"my","ipa":"/maɪ/","meaning":"của tôi"},{"word":"high","ipa":"/haɪ/","meaning":"cao"},{"word":"idea","ipa":"/aɪˈdɪə/","meaning":"ý tưởng"},{"word":"night","ipa":"/naɪt/","meaning":"đêm"}]},{"symbol":"/aʊ/","examples":[{"word":"about","ipa":"/əˈbaʊt/","meaning":"về"},{"word":"cow","ipa":"/kaʊ/","meaning":"con bò"},{"word":"now","ipa":"/naʊ/","meaning":"bây giờ"},{"word":"hour","ipa":"/aʊə/","meaning":"giờ"},{"word":"house","ipa":"/haʊs/","meaning":"nhà"},{"word":"down","ipa":"/daʊn/","meaning":"xuống"}]},{"symbol":"/eə/","examples":[{"word":"share","ipa":"/ʃeə/","meaning":"chia sẻ"},{"word":"hair","ipa":"/heə/","meaning":"tóc"},{"word":"care","ipa":"/keə/","meaning":"quan tâm"},{"word":"bear","ipa":"/beə/","meaning":"gấu"}]},{"symbol":"/eɪ/","examples":[{"word":"pay","ipa":"/peɪ/","meaning":"trả tiền"},{"word":"explain","ipa":"/ɪkˈspleɪn/","meaning":"giải thích"},{"word":"day","ipa":"/deɪ/","meaning":"ngày"},{"word":"late","ipa":"/leɪt/","meaning":"muộn"}]},{"symbol":"/oʊ/","examples":[{"word":"go","ipa":"/ɡoʊ/","meaning":"đi"}]},{"symbol":"/ɔɪ/","examples":[{"word":"point","ipa":"/pɔɪnt/","meaning":"điểm"},{"word":"boy","ipa":"/bɔɪ/","meaning":"cậu bé"},{"word":"toy","ipa":"/tɔɪ/","meaning":"đồ chơi"},{"word":"coin","ipa":"/kɔɪn/","meaning":"đồng xu"}]},{"symbol":"/əʊ/","examples":[{"word":"boat","ipa":"/bəʊt/","meaning":"thuyền"},{"word":"go","ipa":"/ɡəʊ/","meaning":"đi"},{"word":"show","ipa":"/ʃəʊ/","meaning":"cho xem"},{"word":"goal","ipa":"/ɡəʊl/","meaning":"mục tiêu"},{"word":"know","ipa":"/nəʊ/","meaning":"biết"},{"word":"coat","ipa":"/kəʊt/","meaning":"áo khoác"}]},{"symbol":"/ɪə/","examples":[{"word":"idea","ipa":"/aɪˈdɪə/","meaning":"ý tưởng"},{"word":"hear","ipa":"/hɪə/","meaning":"nghe"},{"word":"here","ipa":"/hɪə/","meaning":"ở đây"},{"word":"near","ipa":"/nɪə/","meaning":"gần"},{"word":"fear","ipa":"/fɪə/","meaning":"sợ hãi"}]},{"symbol":"/ʊə/","examples":[{"word":"pure","ipa":"/pjʊə/","meaning":"tinh khiết"},{"word":"cure","ipa":"/kjʊə/","meaning":"chữa trị"},{"word":"tour","ipa":"/tʊə/","meaning":"chuyến du lịch"},{"word":"hour","ipa":"/aʊə/","meaning":"giờ"}]}]},"questions":[{"id":"diphthongs-1","kind":"blank","prompt":"She couldn't _____ for the concert tickets.","symbol":"/eɪ/","options":[{"id":"a","text":"pay","ipa":"/peɪ/","meaning":"trả tiền"},{"id":"b","text":"buy","ipa":"/baɪ/","meaning":"mua"},{"id":"c","text":"spend","ipa":"/spend/","meaning":"chi tiêu"},{"id":"d","text":"afford","ipa":"/əˈfɔːd/","meaning":"có đủ khả năng chi trả"}],"answer":"a","explain":"Từ 'pay' chứa âm /eɪ/ trong khi các từ khác không có âm này"},{"id":"diphthongs-2","kind":"sound","prompt":"Which word contains the sound /aʊ/?","symbol":"/aʊ/","options":[{"id":"a","text":"boat","ipa":"/bəʊt/","meaning":"thuyền"},{"id":"b","text":"about","ipa":"/əˈbaʊt/","meaning":"về"},{"id":"c","text":"boot","ipa":"/buːt/","meaning":"ủng"},{"id":"d","text":"bought","ipa":"/bɔːt/","meaning":"đã mua"}],"answer":"b","explain":"Chỉ có từ 'about' chứa âm /aʊ/, các từ khác có âm khác"},{"id":"diphthongs-3","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/aɪ/","options":[{"id":"a","text":"time","underline":"i","ipa":"/taɪm/","meaning":"thời gian"},{"id":"b","text":"my","underline":"y","ipa":"/maɪ/","meaning":"của tôi"},{"id":"c","text":"team","underline":"ea","ipa":"/tiːm/","meaning":"đội"},{"id":"d","text":"high","underline":"igh","ipa":"/haɪ/","meaning":"cao"}],"answer":"c","explain":"Từ 'team' có âm /i:/ trong khi các từ khác có âm /aɪ/"},{"id":"diphthongs-4","kind":"sound","prompt":"Which word contains the sound /əʊ/?","symbol":"/əʊ/","options":[{"id":"a","text":"cow","ipa":"/kaʊ/","meaning":"con bò"},{"id":"b","text":"go","ipa":"/ɡəʊ/","meaning":"đi"},{"id":"c","text":"now","ipa":"/naʊ/","meaning":"bây giờ"},{"id":"d","text":"put","ipa":"/pʊt/","meaning":"đặt"}],"answer":"b","explain":"Chỉ có từ 'go' chứa âm /əʊ/, các từ khác có âm /aʊ/ hoặc /ʊ/"},{"id":"diphthongs-5","kind":"blank","prompt":"The company needs to _____ their new policy with the employees.","symbol":"/eə/","options":[{"id":"a","text":"tell","ipa":"/tel/","meaning":"nói"},{"id":"b","text":"share","ipa":"/ʃeə/","meaning":"chia sẻ"},{"id":"c","text":"show","ipa":"/ʃəʊ/","meaning":"cho xem"},{"id":"d","text":"explain","ipa":"/ɪkˈspleɪn/","meaning":"giải thích"}],"answer":"b","explain":"Từ 'share' chứa âm /eə/ trong khi các từ khác không có âm này"},{"id":"diphthongs-6","kind":"blank","prompt":"I want to _____ to the beach this weekend.","symbol":"/oʊ/","options":[{"id":"a","text":"go","ipa":"/ɡoʊ/","meaning":"đi"},{"id":"b","text":"visit","ipa":"/ˈvɪzɪt/","meaning":"thăm"},{"id":"c","text":"travel","ipa":"/ˈtrævəl/","meaning":"du lịch"},{"id":"d","text":"walk","ipa":"/wɔːk/","meaning":"đi bộ"}],"answer":"a","explain":"Từ 'go' chứa âm /oʊ/ (hoặc /əʊ/ trong tiếng Anh-Anh) trong khi các từ khác không có âm này"},{"id":"diphthongs-7","kind":"blank","prompt":"The _____ of the game is to score more points than your opponent.","symbol":"/ɔɪ/","options":[{"id":"a","text":"point","ipa":"/pɔɪnt/","meaning":"điểm"},{"id":"b","text":"goal","ipa":"/ɡəʊl/","meaning":"mục tiêu"},{"id":"c","text":"rule","ipa":"/ruːl/","meaning":"quy tắc"},{"id":"d","text":"idea","ipa":"/aɪˈdɪə/","meaning":"ý tưởng"}],"answer":"a","explain":"Từ 'point' chứa âm /ɔɪ/ trong khi các từ khác không có âm này"},{"id":"diphthongs-8","kind":"sound","prompt":"Which word contains the sound /ɪə/?","symbol":"/ɪə/","options":[{"id":"a","text":"hear","ipa":"/hɪə/","meaning":"nghe"},{"id":"b","text":"heart","ipa":"/hɑːt/","meaning":"trái tim"},{"id":"c","text":"hair","ipa":"/heə/","meaning":"tóc"},{"id":"d","text":"here","ipa":"/hɪə/","meaning":"ở đây"}],"answer":"a","explain":"Từ 'hear' và 'here' đều chứa âm /ɪə/, trong khi 'heart' có âm /ɑː/ và 'hair' có âm /eə/"},{"id":"diphthongs-9","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/ʊə/","options":[{"id":"a","text":"pure","underline":"u","ipa":"/pjʊə/","meaning":"tinh khiết"},{"id":"b","text":"cure","underline":"u","ipa":"/kjʊə/","meaning":"chữa trị"},{"id":"c","text":"tour","underline":"ou","ipa":"/tʊə/","meaning":"chuyến du lịch"},{"id":"d","text":"poor","underline":"oo","ipa":"/pɔː/","meaning":"nghèo"}],"answer":"d","explain":"Từ 'poor' có âm /ɔː/ trong khi các từ khác có âm /ʊə/"},{"id":"diphthongs-10","kind":"blank","prompt":"Can you _____ what I'm saying?","symbol":"/ɪə/","options":[{"id":"a","text":"hear","ipa":"/hɪə/","meaning":"nghe"},{"id":"b","text":"listen","ipa":"/ˈlɪsn/","meaning":"lắng nghe"},{"id":"c","text":"understand","ipa":"/ˌʌndəˈstænd/","meaning":"hiểu"},{"id":"d","text":"know","ipa":"/nəʊ/","meaning":"biết"}],"answer":"a","explain":"Từ 'hear' chứa âm /ɪə/ trong khi các từ khác không có âm này"},{"id":"diphthongs-11","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/eə/","options":[{"id":"a","text":"care","underline":"a","ipa":"/keə/","meaning":"quan tâm"},{"id":"b","text":"hair","underline":"ai","ipa":"/heə/","meaning":"tóc"},{"id":"c","text":"hear","underline":"ea","ipa":"/hɪə/","meaning":"nghe"},{"id":"d","text":"bear","underline":"ea","ipa":"/beə/","meaning":"gấu"}],"answer":"c","explain":"Từ 'hear' có âm /ɪə/ trong khi các từ khác có âm /eə/"},{"id":"diphthongs-12","kind":"sound","prompt":"Which word contains the sound /ʊə/?","symbol":"/ʊə/","options":[{"id":"a","text":"tour","ipa":"/tʊə/","meaning":"chuyến du lịch"},{"id":"b","text":"four","ipa":"/fɔː/","meaning":"số bốn"},{"id":"c","text":"hour","ipa":"/aʊə/","meaning":"giờ"},{"id":"d","text":"pour","ipa":"/pɔː/","meaning":"đổ"}],"answer":"a","explain":"Chỉ có từ 'tour' chứa âm /ʊə/, các từ khác có âm /ɔː/ hoặc /aʊə/"},{"id":"diphthongs-13","kind":"blank","prompt":"It's _____ time to go to bed.","symbol":"/aɪ/","options":[{"id":"a","text":"night","ipa":"/naɪt/","meaning":"đêm"},{"id":"b","text":"day","ipa":"/deɪ/","meaning":"ngày"},{"id":"c","text":"late","ipa":"/leɪt/","meaning":"muộn"},{"id":"d","text":"early","ipa":"/ˈɜːli/","meaning":"sớm"}],"answer":"a","explain":"Từ 'night' chứa âm /aɪ/ trong khi các từ khác có âm /eɪ/, /eɪ/ và /ɜː/"},{"id":"diphthongs-14","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/aʊ/","options":[{"id":"a","text":"now","underline":"ow","ipa":"/naʊ/","meaning":"bây giờ"},{"id":"b","text":"house","underline":"ou","ipa":"/haʊs/","meaning":"nhà"},{"id":"c","text":"show","underline":"ow","ipa":"/ʃəʊ/","meaning":"chỉ"},{"id":"d","text":"down","underline":"ow","ipa":"/daʊn/","meaning":"xuống"}],"answer":"c","explain":"Từ 'show' có âm /əʊ/ trong khi các từ khác có âm /aʊ/"},{"id":"diphthongs-15","kind":"sound","prompt":"Which word contains the sound /ɔɪ/?","symbol":"/ɔɪ/","options":[{"id":"a","text":"boy","ipa":"/bɔɪ/","meaning":"cậu bé"},{"id":"b","text":"buy","ipa":"/baɪ/","meaning":"mua"},{"id":"c","text":"bow","ipa":"/baʊ/","meaning":"cúi chào"},{"id":"d","text":"boat","ipa":"/bəʊt/","meaning":"thuyền"}],"answer":"a","explain":"Chỉ có từ 'boy' chứa âm /ɔɪ/, các từ khác có âm /aɪ/, /aʊ/ và /əʊ/"},{"id":"diphthongs-16","kind":"blank","prompt":"I want to _____ home now.","symbol":"/əʊ/","options":[{"id":"a","text":"go","ipa":"/ɡəʊ/","meaning":"đi"},{"id":"b","text":"get","ipa":"/ɡet/","meaning":"lấy"},{"id":"c","text":"come","ipa":"/kʌm/","meaning":"đến"},{"id":"d","text":"walk","ipa":"/wɔːk/","meaning":"đi bộ"}],"answer":"a","explain":"Từ 'go' chứa âm /əʊ/ trong khi các từ khác có âm /e/, /ʌ/ và /ɔː/"},{"id":"diphthongs-17","kind":"sound","prompt":"Which word contains the sound /eɪ/?","symbol":"/eɪ/","options":[{"id":"a","text":"bed","ipa":"/bed/","meaning":"giường"},{"id":"b","text":"day","ipa":"/deɪ/","meaning":"ngày"},{"id":"c","text":"dead","ipa":"/ded/","meaning":"chết"},{"id":"d","text":"head","ipa":"/hed/","meaning":"đầu"}],"answer":"b","explain":"Chỉ có từ 'day' chứa âm /eɪ/, các từ khác có âm /e/"},{"id":"diphthongs-18","kind":"blank","prompt":"I need to buy a _____ for my sister's birthday.","symbol":"/aɪ/","options":[{"id":"a","text":"gift","ipa":"/ɡɪft/","meaning":"quà tặng"},{"id":"b","text":"bike","ipa":"/baɪk/","meaning":"xe đạp"},{"id":"c","text":"book","ipa":"/bʊk/","meaning":"sách"},{"id":"d","text":"pen","ipa":"/pen/","meaning":"bút"}],"answer":"b","explain":"Từ 'bike' chứa âm /aɪ/ trong khi các từ khác có âm /ɪ/, /ʊ/ và /e/"},{"id":"diphthongs-19","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/ɔɪ/","options":[{"id":"a","text":"boy","underline":"oy","ipa":"/bɔɪ/","meaning":"cậu bé"},{"id":"b","text":"toy","underline":"oy","ipa":"/tɔɪ/","meaning":"đồ chơi"},{"id":"c","text":"coin","underline":"oi","ipa":"/kɔɪn/","meaning":"đồng xu"},{"id":"d","text":"boat","underline":"oa","ipa":"/bəʊt/","meaning":"thuyền"}],"answer":"d","explain":"Từ 'boat' có âm /əʊ/ trong khi các từ khác có âm /ɔɪ/"},{"id":"diphthongs-20","kind":"sound","prompt":"Which word contains the sound /əʊ/?","symbol":"/əʊ/","options":[{"id":"a","text":"cow","ipa":"/kaʊ/","meaning":"con bò"},{"id":"b","text":"coat","ipa":"/kəʊt/","meaning":"áo khoác"},{"id":"c","text":"cut","ipa":"/kʌt/","meaning":"cắt"},{"id":"d","text":"caught","ipa":"/kɔːt/","meaning":"bắt được"}],"answer":"b","explain":"Chỉ có từ 'coat' chứa âm /əʊ/, các từ khác có âm /aʊ/, /ʌ/ và /ɔː/"},{"id":"diphthongs-21","kind":"blank","prompt":"The _____ is in the field eating grass.","symbol":"/aʊ/","options":[{"id":"a","text":"cow","ipa":"/kaʊ/","meaning":"con bò"},{"id":"b","text":"horse","ipa":"/hɔːs/","meaning":"con ngựa"},{"id":"c","text":"sheep","ipa":"/ʃiːp/","meaning":"con cừu"},{"id":"d","text":"goat","ipa":"/ɡəʊt/","meaning":"con dê"}],"answer":"a","explain":"Từ 'cow' chứa âm /aʊ/ trong khi các từ khác có âm /ɔː/, /iː/ và /əʊ/"},{"id":"diphthongs-22","kind":"different","prompt":"Find the word with a different vowel sound:","symbol":"/ɪə/","options":[{"id":"a","text":"hear","underline":"ea","ipa":"/hɪə/","meaning":"nghe"},{"id":"b","text":"near","underline":"ea","ipa":"/nɪə/","meaning":"gần"},{"id":"c","text":"fear","underline":"ea","ipa":"/fɪə/","meaning":"sợ hãi"},{"id":"d","text":"bear","underline":"ea","ipa":"/beə/","meaning":"con gấu"}],"answer":"d","explain":"Từ 'bear' có âm /eə/ trong khi các từ khác có âm /ɪə/"},{"id":"diphthongs-23","kind":"sound","prompt":"Which word contains the sound /eə/?","symbol":"/eə/","options":[{"id":"a","text":"here","ipa":"/hɪə/","meaning":"ở đây"},{"id":"b","text":"hair","ipa":"/heə/","meaning":"tóc"},{"id":"c","text":"hear","ipa":"/hɪə/","meaning":"nghe"},{"id":"d","text":"her","ipa":"/hɜː/","meaning":"cô ấy"}],"answer":"b","explain":"Chỉ có từ 'hair' chứa âm /eə/, các từ khác có âm /ɪə/, /ɪə/ và /ɜː/"},{"id":"diphthongs-24","kind":"blank","prompt":"We booked a guided _____ of the museum.","symbol":"/ʊə/","options":[{"id":"a","text":"tour","ipa":"/tʊə/","meaning":"chuyến tham quan"},{"id":"b","text":"visit","ipa":"/ˈvɪzɪt/","meaning":"chuyến thăm"},{"id":"c","text":"trip","ipa":"/trɪp/","meaning":"chuyến đi"},{"id":"d","text":"walk","ipa":"/wɔːk/","meaning":"đi bộ"}],"answer":"a","explain":"Từ 'tour' chứa âm /ʊə/ trong khi các từ khác có âm /ɪ/, /ɪ/ và /ɔː/"}]}
