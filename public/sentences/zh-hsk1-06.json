{"id":"zh-hsk1-06","lang":"zh","level":"HSK1","index":6,"sentences":[{"id":"3538035","text":"明天，我们还来。","tokens":["明天","我们","还","来"],"reading":"Míngtiān wǒmen hái lái","meaning":"Ngày mai, chúng tôi còn đến đây."},{"id":"3538064","text":"没一个人来过。","tokens":["没","一个人","来","过"],"reading":"Méi yīgèrén lái guo","meaning":"Chẳng ai đến cả."},{"id":"3658530","text":"那是我的爱好。","tokens":["那是","我","的","爱好"],"reading":"Nàshi wǒ de àihào","meaning":"Đó là sở thích của tui."},{"id":"3742414","text":"我正在学日文。","tokens":["我","正在","学","日文"],"reading":"Wǒ zhèngzài xué Rìwén","meaning":"Tôi đang học tiếng Nhật."},{"id":"4302120","text":"他是我的手下。","tokens":["他","是","我","的","手下"],"reading":"Tā shì wǒ de shǒuxià","meaning":"Nó là thuộc hạ của tôi."},{"id":"4673805","text":"我不喜欢学习。","tokens":["我","不","喜欢","学习"],"reading":"Wǒ bù xǐhuan xuéxí","meaning":"Tôi không thích học."},{"id":"4933767","text":"我的英文很差。","tokens":["我的","英文","很","差"],"reading":"Wǒde Yīngwén hěn chà","meaning":"Tiếng Anh của tôi rất tệ."},{"id":"8865167","text":"他现在在医院。","tokens":["他","现在","在","医院"],"reading":"Tā xiànzài zài yīyuàn","meaning":"Bây giờ anh ấy đang ở trong bệnh viện."},{"id":"9987039","text":"德语真的很难。","tokens":["德语","真","的","很","难"],"reading":"Déyǔ zhēn de hěn nán","meaning":"Tiếng Đức khó quá."},{"id":"13550627","text":"您去过非洲吗？","tokens":["您","去","过","非洲","吗"],"reading":"Nín qù guo Fēizhōu ma","meaning":"Bạn đã tới châu Phi bao giờ chưa?"}]}