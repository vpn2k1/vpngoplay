{"id":"ja-n5-05","lang":"ja","level":"N5","index":5,"sentences":[{"id":"4882","text":"そこに問題がある。","tokens":["そこ","に","問題","が","ある"],"reading":"そこにもんだいがある","ruby":[["そこに",""],["問題","もんだい"],["がある。",""]],"meaning":"Vấn đề nằm ở đó."},{"id":"77951","text":"料理が上手ですね。","tokens":["料理","が","上手","です","ね"],"reading":"りょうりがじょうずですね","ruby":[["料理","りょうり"],["が",""],["上手","じょうず"],["ですね。",""]],"meaning":"Bạn giỏi nấu ăn nhỉ."},{"id":"82592","text":"帽子を脱ぎなさい。","tokens":["帽子","を","脱ぎ","なさい"],"reading":"ぼうしをぬぎなさい","ruby":[["帽子","ぼうし"],["を",""],["脱","ぬ"],["ぎなさい。",""]],"meaning":"Hãy cởi mũ ra."},{"id":"124389","text":"冬が近づいてくる。","tokens":["冬","が","近づいて","くる"],"reading":"ふゆがちかづいてくる","ruby":[["冬","ふゆ"],["が",""],["近","ちか"],["づいてくる。",""]],"meaning":"Mùa đông đang đến."},{"id":"124392","text":"冬が近づいている。","tokens":["冬","が","近づいている"],"reading":"ふゆがちかづいている","ruby":[["冬","ふゆ"],["が",""],["近","ちか"],["づいている。",""]],"meaning":"Mùa đông đang đến."},{"id":"124500","text":"土砂降りの雨だよ。","tokens":["土砂降り","の","雨","だ","よ"],"reading":"どしゃぶりのあめだよ","ruby":[["土砂降","どしゃぶ"],["りの",""],["雨","あめ"],["だよ。",""]],"meaning":"Trời đang mưa như trút nước vậy."},{"id":"142339","text":"石鹸がありません。","tokens":["石鹸","が","ありません"],"reading":"せっけんがありません","ruby":[["石鹸","せっけん"],["がありません。",""]],"meaning":"Tôi không có xà phòng."},{"id":"152904","text":"私は勉強が嫌いだ。","tokens":["私","は","勉強","が","嫌い","だ"],"reading":"わたしはべんきょうがきらいだ","ruby":[["私","わたし"],["は",""],["勉強","べんきょう"],["が",""],["嫌","きら"],["いだ。",""]],"meaning":"Tôi không ưa việc học."},{"id":"152960","text":"私は風邪をひいた。","tokens":["私","は","風邪をひいた"],"reading":"わたしはかぜをひいた","ruby":[["私","わたし"],["は",""],["風邪","かぜ"],["をひいた。",""]],"meaning":"Tôi bị cúm."},{"id":"159671","text":"私はそれを忘れた。","tokens":["私","は","それ","を","忘れた"],"reading":"わたしはそれをわすれた","ruby":[["私","わたし"],["はそれを",""],["忘","わす"],["れた。",""]],"meaning":"Tôi đã quên điều đó."}]}