{"id":"en-c1c2-01","lang":"en","level":"C1–C2","index":1,"sentences":[{"id":"3826840","text":"I reluctantly agreed.","tokens":["I","reluctantly","agreed"],"meaning":"Tôi miễn cưỡng đồng ý."},{"id":"4451494","text":"You're my heroine.","tokens":["You're","my","heroine"],"meaning":"Bạn là người hùng của tôi."},{"id":"4495407","text":"What a hypocrite!","tokens":["What","a","hypocrite"],"meaning":"Đúng là đồ đạo đức giả!"},{"id":"6274667","text":"I was brainwashed.","tokens":["I","was","brainwashed"],"meaning":"Tôi bị tẩy não."},{"id":"8895476","text":"We like diversity.","tokens":["We","like","diversity"],"meaning":"Chúng tôi thích sự đa dạng."},{"id":"9286088","text":"I love hedgehogs.","tokens":["I","love","hedgehogs"],"meaning":"Tôi thích nhím gai."},{"id":"13492891","text":"Fossils are everywhere.","tokens":["Fossils","are","everywhere"],"meaning":"Hoá thạch ở khắp nơi."},{"id":"13709968","text":"Humans are parasites.","tokens":["Humans","are","parasites"],"meaning":"Con người là kí sinh trùng."},{"id":"14010264","text":"Who was standing?","tokens":["Who","was","standing"],"meaning":"Ai đang đứng vậy?"},{"id":"65603","text":"Our house adjoins his.","tokens":["Our","house","adjoins","his"],"meaning":"Nhà chúng ta/chúng tôi sát vách nhà anh ta."}]}