{"id":"ja-n1-04","lang":"ja","level":"N1","index":4,"sentences":[{"id":"115612","text":"彼は、まきを束ねた。","tokens":["彼","は","まき","を","束ねた"],"reading":"かれはまきをたばねた","ruby":[["彼","かれ"],["は、まきを",""],["束","たば"],["ねた。",""]],"meaning":"Anh ấy buộc một bó củi."},{"id":"122329","text":"日本語が話せますか。","tokens":["日本語","が","話せます","か"],"reading":"にほんごがはなせますか","ruby":[["日本語","にほんご"],["が",""],["話","はな"],["せますか。",""]],"meaning":"Ông có nói tiếng Nhật không?"},{"id":"125795","text":"鳥は昆虫の天敵です。","tokens":["鳥","は","昆虫","の","天敵","です"],"reading":"とりはこんちゅうのてんてきです","ruby":[["鳥","とり"],["は",""],["昆虫","こんちゅう"],["の",""],["天敵","てんてき"],["です。",""]],"meaning":"Chim là thiên địch của côn trùng."},{"id":"126196","text":"朝食は何を食べたの？","tokens":["朝食","は","何","を","食べた","の"],"reading":"ちょうしょくはなにをたべたの","ruby":[["朝食","ちょうしょく"],["は",""],["何","なに"],["を",""],["食","た"],["べたの？",""]],"meaning":"Bữa sáng bạn ăn gì?"},{"id":"137805","text":"台風で川が氾濫した。","tokens":["台風","で","川","が","氾濫","した"],"reading":"たいふうでかわがはんらんした","ruby":[["台風","たいふう"],["で",""],["川","かわ"],["が",""],["氾濫","はんらん"],["した。",""]],"meaning":"Cơn bão làm nước sông bị tràn ra."},{"id":"141428","text":"千里の道も一歩から。","tokens":["千里","の","道","も","一歩","から"],"reading":"せんりのみちもいっぽから","ruby":[["千里","せんり"],["の",""],["道","みち"],["も",""],["一","いっ"],["歩","ぽ"],["から。",""]],"meaning":"Vạn sự khởi đầu nan."},{"id":"144068","text":"人々は彼を嘲笑った。","tokens":["人々","は","彼","を","嘲笑った"],"reading":"ひとびとはかれをあざわらった","ruby":[["人々","ひとびと"],["は",""],["彼","かれ"],["を",""],["嘲笑","あざわら"],["った。",""]],"meaning":"Họ cười nhạo anh ta."},{"id":"182411","text":"救急車を呼んでくれ。","tokens":["救急車","を","呼んで","くれ"],"reading":"きゅうきゅうしゃをよんでくれ","ruby":[["救急","きゅうきゅう"],["車","しゃ"],["を",""],["呼","よ"],["んでくれ。",""]],"meaning":"Gọi cấp cứu đi."},{"id":"236695","text":"私は矢を的に当てた。","tokens":["私","は","矢","を","的","に","当てた"],"reading":"わたしはやをてきにあてた","ruby":[["私","わたし"],["は",""],["矢","や"],["を",""],["的","てき"],["に",""],["当","あ"],["てた。",""]],"meaning":"Tôi bắn mũi tên trúng đích."},{"id":"87710","text":"彼女は頭のさえた人だ。","tokens":["彼女","は","頭