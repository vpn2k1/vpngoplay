{"id":"zh-hsk56-03","lang":"zh","level":"HSK5–6","index":3,"sentences":[{"id":"3526255","text":"突然天下起雨来。","tokens":["突然","天下","起","雨","来"],"reading":"Tūrán tiānxià qǐ yǔ lái","meaning":"Bỗng nhiên trời mưa."},{"id":"3526265","text":"哪间卧室都干净。","tokens":["哪","间","卧室","都","干净"],"reading":"Nǎ jiān wòshì dōu gānjìng","meaning":"Phòng ngủ nào cũng sạch sẽ."},{"id":"3537860","text":"沸水蒸发成气体。","tokens":["沸水","蒸发","成","气体"],"reading":"Fèishuǐ zhēngfā chéng qìtǐ","meaning":"Nước sôi bốc thành hơi."},{"id":"4265886","text":"木星有几个卫星？","tokens":["木星","有","几个","卫星"],"reading":"Mùxīng yǒu jǐge wèixīng","meaning":"Sao Mộc có bao nhiêu mặt trăng?"},{"id":"5617245","text":"可能你应该放弃。","tokens":["可能","你","应该","放弃"],"reading":"Kěnéng nǐ yīnggāi fàngqì","meaning":"Có lẽ bạn nên bỏ cuộc."},{"id":"9401485","text":"你真的拥抱汤姆？","tokens":["你","真","的","拥抱","汤姆"],"reading":"Nǐ zhēn de yōngbào Tāngmǔ","meaning":"Cậu thật sự ôm Tom?"},{"id":"343235","text":"贸易帮助国家发展。","tokens":["贸易","帮助","国家","发展"],"reading":"Màoyì bāngzhù guójiā fāzhǎn","meaning":"Mậu dịch hỗ trợ sự phát triển của quốc gia."},{"id":"427597","text":"他放弃了所有希望。","tokens":["他","放弃","了","所有","希望"],"reading":"Tā fàngqì le suǒyǒu xīwàng","meaning":"Anh ta từ bỏ mọi hy vọng"},{"id":"791493","text":"我见到了王子真人。","tokens":["我","见到","了","王子","真人"],"reading":"Wǒ jiàndào le wángzǐ zhēnrén","meaning":"Tôi đã gặp Vương tử ngoài đời thật."},{"id":"840746","text":"她大约跟我同年纪。","tokens":["她","大约","跟","我","同","年纪"],"reading":"Tā dàyuē gēn wǒ tóng niánjì","meaning":"Cô ấy tầm tuổi tôi."}]}