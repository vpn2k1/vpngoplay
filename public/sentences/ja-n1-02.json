{"id":"ja-n1-02","lang":"ja","level":"N1","index":2,"sentences":[{"id":"78212","text":"龍は空想の動物だ。","tokens":["龍","は","空想","の","動物","だ"],"reading":"りゅうはくうそうのどうぶつだ","ruby":[["龍","りゅう"],["は",""],["空想","くうそう"],["の",""],["動物","どうぶつ"],["だ。",""]],"meaning":"Rồng là động vật không tưởng."},{"id":"99064","text":"彼は陸軍に入った。","tokens":["彼","は","陸軍","に","入った"],"reading":"かれはりくぐんにはいった","ruby":[["彼","かれ"],["は",""],["陸軍","りくぐん"],["に",""],["入","はい"],["った。",""]],"meaning":"Anh ta gia nhập quân đội."},{"id":"99401","text":"彼は約束に背いた。","tokens":["彼","は","約束","に","背いた"],"reading":"かれはやくそくにそむいた","ruby":[["彼","かれ"],["は",""],["約束","やくそく"],["に",""],["背","そむ"],["いた。",""]],"meaning":"Anh ấy đã phản bội lời hứa của chính mình."},{"id":"108017","text":"彼は刑法の権威だ。","tokens":["彼","は","刑法","の","権威","だ"],"reading":"かれはけいほうのけんいだ","ruby":[["彼","かれ"],["は",""],["刑法","けいほう"],["の",""],["権威","けんい"],["だ。",""]],"meaning":"Ông ấy là một nhà chức trách thực thi pháp luật về hình sự."},{"id":"108512","text":"彼は喫煙をやめた。","tokens":["彼","は","喫煙","を","やめた"],"reading":"かれはきつえんをやめた","ruby":[["彼","かれ"],["は",""],["喫煙","きつえん"],["をやめた。",""]],"meaning":"Anh ấy đã bỏ thuốc."},{"id":"108780","text":"彼は完壁な紳士だ。","tokens":["彼","は","完壁な","紳士","だ"],"reading":"かれはかんかべなしんしだ","ruby":[["彼","かれ"],["は",""],["完","かん"],["壁","かべ"],["な",""],["紳士","しんし"],["だ。",""]],"meaning":"Anh ấy là một quý ông hoàn hảo."},{"id":"142884","text":"正直は最良の方策。","tokens":["正直","は","最良","の","方策"],"reading":"しょうじきはさいりょうのほうさく","ruby":[["正直","しょうじき"],["は",""],["最良","さいりょう"],["の",""],["方策","ほうさく"],["。",""]],"meaning":"Thật thà là thượng sách."},{"id":"143738","text":"水は堤防を越えた。","tokens":["水","は","堤防","を","越えた"],"reading":"みずはていぼうをこえた","ruby":[["水","みず"],["は",""],["堤防","ていぼう"],["を",""],["越","こ"],["えた。",""]],"meaning":"Nước đã tràn qua bờ đê."},{"id":"143764","text":"水は光を反射する。","tokens":["水","は","光","を","反射","する"],"reading":"みずはひかりをはんしゃする","ruby":[["水","みず"],["は",""],["光","ひかり"],["を",""],["反射","はんしゃ"],["する。",""]],"meaning":"Nước phản chiếu ánh sáng."},{"id":"168550","t