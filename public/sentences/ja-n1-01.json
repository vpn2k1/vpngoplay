{"id":"ja-n1-01","lang":"ja","level":"N1","index":1,"sentences":[{"id":"77725","text":"類は友を呼ぶ。","tokens":["類","は","友","を","呼ぶ"],"reading":"るいはともをよぶ","ruby":[["類","るい"],["は",""],["友","とも"],["を",""],["呼","よ"],["ぶ。",""]],"meaning":"Ngưu tầm ngưu, mã tầm mã."},{"id":"124963","text":"転ばぬ先の杖。","tokens":["転ばぬ","先の","杖"],"reading":"ころばぬさきのつえ","ruby":[["転","ころ"],["ばぬ",""],["先","さき"],["の",""],["杖","つえ"],["。",""]],"meaning":"Phòng bệnh hơn chữa bệnh."},{"id":"126233","text":"朝の八時です。","tokens":["朝","の","八","時","です"],"reading":"あさのはちじです","ruby":[["朝","あさ"],["の",""],["八","はち"],["時","じ"],["です。",""]],"meaning":"Bây giờ là 8 giờ sáng."},{"id":"171112","text":"今夜は外食だ。","tokens":["今夜","は","外食","だ"],"reading":"こんやはがいしょくだ","ruby":[["今夜","こんや"],["は",""],["外食","がいしょく"],["だ。",""]],"meaning":"Tôi sẽ ăn ngoài tối nay."},{"id":"183187","text":"気色悪い奴だ。","tokens":["気色悪い","奴","だ"],"reading":"きしょくわるいやつだ","ruby":[["気色","きしょく"],["悪","わる"],["い",""],["奴","やつ"],["だ。",""]],"meaning":"Anh ta khiến tôi cảm thấy ghê tởm."},{"id":"100044","text":"彼は法を犯した。","tokens":["彼","は","法","を","犯した"],"reading":"かれはほうをおかした","ruby":[["彼","かれ"],["は",""],["法","ほう"],["を",""],["犯","おか"],["した。",""]],"meaning":"Anh ấy đã vi phạm pháp luật."},{"id":"167347","text":"私だけが残った。","tokens":["私","だけ","が","残った"],"reading":"わたしだけがのこった","ruby":[["私","わたし"],["だけが",""],["残","のこ"],["った。",""]],"meaning":"Chỉ còn lại một mình tôi."},{"id":"173522","text":"甲の薬は乙の毒。","tokens":["甲","の","薬","は","乙","の","毒"],"reading":"こうのくすりはおつのどく","ruby":[["甲","こう"],["の",""],["薬","くすり"],["は",""],["乙","おつ"],["の",""],["毒","どく"],["。",""]],"meaning":"Cái sướng cho người này là cái khổ cho người khác."},{"id":"176543","text":"形勢は逆転した。","tokens":["形勢","は","逆転","した"],"reading":"けいせいはぎゃくてんした","ruby":[["形勢","けいせい"],["は",""],["逆転","ぎゃくてん"],["した。",""]],"meaning":"Tình thế đã đảo ngược."},{"id":"182413","text":"救急車を呼んで！","tokens":["救急車","を","呼んで"],"reading":"きゅうきゅうしゃをよんで","ruby":[["救急","きゅうきゅう"],["車","しゃ"],["を",""],["呼","よ"],["んで！",""]],"meaning":"Gọi cấp cứu đi."}]}