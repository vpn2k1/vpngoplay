{"id":"zh-hsk4-02","lang":"zh","level":"HSK4","index":2,"sentences":[{"id":"3537648","text":"你男朋友真帅！","tokens":["你","男朋友","真","帅"],"reading":"Nǐ nánpéngyou zhēn shuài","meaning":"Bạn trai của bạn đẹp trai quá!"},{"id":"6058556","text":"工业发展迅速。","tokens":["工业","发展","迅速"],"reading":"Gōngyè fāzhǎn xùnsù","meaning":"Công nghiệp phát triển nhanh chóng."},{"id":"8696221","text":"和我约会好吗？","tokens":["和","我","约会","好","吗"],"reading":"Hé wǒ yuēhuì hǎo ma","meaning":"Em có thể đi hẹn hò với tôi không?"},{"id":"9489493","text":"汤姆脱了口罩。","tokens":["汤姆","脱","了","口罩"],"reading":"Tāngmǔ tuō le kǒuzhào","meaning":"Tom đã tháo mặt nạ ra rồi đấy."},{"id":"348507","text":"教授微微笑了笑。","tokens":["教授","微微","笑","了","笑"],"reading":"Jiàoshòu wēiwēi xiào le xiào","meaning":"Ông giáo sư mỉm cười."},{"id":"429114","text":"你必须停止吸烟。","tokens":["你","必须","停止","吸烟"],"reading":"Nǐ bìxū tíngzhǐ xīyān","meaning":"Bạn phải ngưng hút thuốc."},{"id":"463414","text":"他们是我的兄弟。","tokens":["他们","是","我","的","兄弟"],"reading":"Tāmen shì wǒ de xiōngdì","meaning":"Họ là anh em của tôi."},{"id":"833004","text":"你有医疗保险吗？","tokens":["你","有","医疗","保险","吗"],"reading":"Nǐ yǒu yīliáo bǎoxiǎn ma","meaning":"Bạn có bảo hiểm y tế không?"},{"id":"861132","text":"这附近有医院吗？","tokens":["这","附近","有","医院","吗"],"reading":"Zhè fùjìn yǒu yīyuàn ma","meaning":"Gần đây có bệnh viện không?"},{"id":"1019299","text":"我担心他会失败。","tokens":["我","担心","他","会","失败"],"reading":"Wǒ dānxīn tā huì shībài","meaning":"Tôi e rằng ông ấy sẽ thất bại."}]}