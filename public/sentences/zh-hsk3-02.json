{"id":"zh-hsk3-02","lang":"zh","level":"HSK3","index":2,"sentences":[{"id":"430993","text":"停止大声说话。","tokens":["停止","大声","说话"],"reading":"Tíngzhǐ dàshēng shuōhuà","meaning":"Cấm nói lớn tiếng."},{"id":"707685","text":"不要发出声音。","tokens":["不","要","发出","声音"],"reading":"Bù yào fāchū shēngyīn","meaning":"Đừng tạo tiếng động."},{"id":"875324","text":"我要环游世界。","tokens":["我","要","环游","世界"],"reading":"Wǒ yào huányóu shìjiè","meaning":"Tôi muốn đi vòng quanh thế giới."},{"id":"3537962","text":"这篇文章很好。","tokens":["这","篇","文章","很","好"],"reading":"Zhè piān wénzhāng hěn hǎo","meaning":"Bài văn này rất hay."},{"id":"3537965","text":"这张桌子不好。","tokens":["这","张","桌子","不","好"],"reading":"Zhè zhāng zhuōzi bù hǎo","meaning":"Cái bàn này không tốt."},{"id":"16","text":"那是一张近照吗？","tokens":["那是","一","张","近照","吗"],"reading":"Nàshi yī zhāng jìnzhào ma","meaning":"Tấm hình này có mới không?"},{"id":"333193","text":"她一整晚都在哭。","tokens":["她","一","整","晚","都","在","哭"],"reading":"Tā yī zhěng wǎn dōu zài kū","meaning":"Cô ấy đã khóc suốt đêm."},{"id":"339230","text":"她整晚不停地哭。","tokens":["她","整","晚","不","停","地","哭"],"reading":"Tā zhěng wǎn bù tíng de kū","meaning":"Cô ấy đã khóc cả đêm."},{"id":"346668","text":"他状态真的很好。","tokens":["他","状态","真","的","很","好"],"reading":"Tā zhuàngtài zhēn de hěn hǎo","meaning":"Anh ta có một cơ thể thật đẹp."},{"id":"347114","text":"一切都不会改变。","tokens":["一切","都","不","会","改变"],"reading":"Yīqiè dōu bù huì gǎibiàn","meaning":"Không có gì thay đổi cả."}]}