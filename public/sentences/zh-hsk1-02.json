{"id":"zh-hsk1-02","lang":"zh","level":"HSK1","index":2,"sentences":[{"id":"4262233","text":"美洲很大。","tokens":["美洲","很","大"],"reading":"Měizhōu hěn dà","meaning":"Nước Mỹ rất rộng lớn."},{"id":"4835859","text":"你想我吗？","tokens":["你","想","我","吗"],"reading":"Nǐ xiǎng wǒ ma","meaning":"Bạn có nhớ tôi không?"},{"id":"8696442","text":"汤姆在吗？","tokens":["汤姆","在","吗"],"reading":"Tāngmǔ zài ma","meaning":"Tom có ở đó không?"},{"id":"10260759","text":"她说法语。","tokens":["她","说","法语"],"reading":"Tā shuō Fǎyǔ","meaning":"Cô ấy nói tiếng Pháp."},{"id":"1","text":"我们试试看！","tokens":["我们","试试","看"],"reading":"Wǒmen shìshi kàn","meaning":"Chúng ta hãy thử một vài thứ."},{"id":"136236","text":"我会说法语。","tokens":["我","会","说","法语"],"reading":"Wǒ huì shuō Fǎyǔ","meaning":"Tôi biết nói tiếng Pháp."},{"id":"336045","text":"今天有点冷。","tokens":["今天","有点","冷"],"reading":"Jīntiān yǒudiǎn lěng","meaning":"Hôm nay trời hơi lạnh."},{"id":"349704","text":"学学你姐姐。","tokens":["学","学","你","姐姐"],"reading":"Xué xué nǐ jiějie","meaning":"Mày học chị mày đi."},{"id":"431556","text":"你认识他吗?","tokens":["你","认识","他","吗"],"reading":"Nǐ rènshi tā ma","meaning":"Mày có biết nó không?"},{"id":"483022","text":"他是法国人。","tokens":["他","是","法国人"],"reading":"Tā shì Fǎguórén","meaning":"Anh ấy là người Pháp."}]}