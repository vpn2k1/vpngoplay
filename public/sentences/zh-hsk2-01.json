{"id":"zh-hsk2-01","lang":"zh","level":"HSK2","index":1,"sentences":[{"id":"1411641","text":"灯亮着。","tokens":["灯","亮","着"],"reading":"Dēng liàng zhe","meaning":"Đèn đang sáng."},{"id":"51","text":"那又怎样?","tokens":["那","又","怎样"],"reading":"Nà yòu zěnyàng","meaning":"Thì sao?"},{"id":"4302134","text":"你该走了。","tokens":["你","该","走","了"],"reading":"Nǐ gāi zǒu le","meaning":"Anh nên đi đi."},{"id":"4","text":"这是什么啊？","tokens":["这","是","什","么","啊"],"reading":"Zhè shì shén me ā","meaning":"Cái này là gì?"},{"id":"60","text":"哪里有问题?","tokens":["哪里","有","问题"],"reading":"Nǎlǐ yǒu wèntí","meaning":"Vấn đề ở đâu?"},{"id":"408242","text":"黑色很衬你。","tokens":["黑色","很","衬","你"],"reading":"Hēisè hěn chèn nǐ","meaning":"Màu đen hợp với bạn"},{"id":"824627","text":"你可以走了。","tokens":["你","可以","走","了"],"reading":"Nǐ kěyǐ zǒu le","meaning":"Mày có thể đi."},{"id":"1066752","text":"我没洗头发。","tokens":["我","没","洗头","发"],"reading":"Wǒ méi xǐtóu fā","meaning":"Tôi chưa gội đầu."},{"id":"1411550","text":"别让狗进来。","tokens":["别","让","狗","进来"],"reading":"Bié ràng gǒu jìnlái","meaning":"Không được cho chó vào bên trong."},{"id":"2694207","text":"我来自法国.","tokens":["我","来自","法国"],"reading":"Wǒ láizì Fǎguó","meaning":"Tôi đến từ nước Pháp"}]}