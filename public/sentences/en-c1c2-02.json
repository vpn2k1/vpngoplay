{"id":"en-c1c2-02","lang":"en","level":"C1–C2","index":2,"sentences":[{"id":"292237","text":"He turned a somersault.","tokens":["He","turned","a","somersault"],"meaning":"Anh ấy đã nhảy một cú lộn nhào."},{"id":"1123558","text":"He's supporting you voluntarily.","tokens":["He's","supporting","you","voluntarily"],"meaning":"Anh ấy đang tự nguyện hỗ trợ bạn."},{"id":"2879060","text":"She interrogated a suspect.","tokens":["She","interrogated","a","suspect"],"meaning":"Cô ấy đã tra hỏi một nghi phạm."},{"id":"2946395","text":"Don't be so glum.","tokens":["Don't","be","so","glum"],"meaning":"Đừng có rầu rĩ quá như thế."},{"id":"3735905","text":"That's an interesting hypothesis.","tokens":["That's","an","interesting","hypothesis"],"meaning":"Đó là một giả thuyết thú vị."},{"id":"6270836","text":"I don't like grapefruit.","tokens":["I","don't","like","grapefruit"],"meaning":"Tôi không thích bưởi chùm."},{"id":"6568176","text":"Could you please elaborate?","tokens":["Could","you","please","elaborate"],"meaning":"Bạn có thể giải thích rõ hơn được không?"},{"id":"7390803","text":"She removed her glasses.","tokens":["She","removed","her","glasses"],"meaning":"Cô ấy tháo kính ra."},{"id":"10650279","text":"That film is unsettling.","tokens":["That","film","is","unsettling"],"meaning":"Bộ phim đó khiến tôi cảm thấy bất an."},{"id":"11268611","text":"My nose is stuffy.","tokens":["My","nose","is","stuffy"],"meaning":"Mũi tôi bị nghẹt."}]}