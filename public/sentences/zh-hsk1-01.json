{"id":"zh-hsk1-01","lang":"zh","level":"HSK1","index":1,"sentences":[{"id":"139673","text":"我爱你。","tokens":["我","爱","你"],"reading":"Wǒ ài nǐ","meaning":"Anh phải lòng em."},{"id":"899617","text":"我到了。","tokens":["我","到","了"],"reading":"Wǒ dào le","meaning":"Tôi đến."},{"id":"10","text":"我不知道。","tokens":["我","不","知道"],"reading":"Wǒ bù zhīdào","meaning":"Tôi không biết."},{"id":"334429","text":"你想我了？","tokens":["你","想","我","了"],"reading":"Nǐ xiǎng wǒ le","meaning":"Bạn có nhớ tôi không?"},{"id":"343752","text":"今天很热。","tokens":["今天","很","热"],"reading":"Jīntiān hěn rè","meaning":"Hôm nay cực nóng."},{"id":"784401","text":"我不要钱。","tokens":["我","不","要","钱"],"reading":"Wǒ bù yào qián","meaning":"Tôi không cần tiền."},{"id":"3365894","text":"我叫山田。","tokens":["我","叫","山田"],"reading":"Wǒ jiào Shāntián","meaning":"Tôi tên là Yamada."},{"id":"3499679","text":"一起来吧。","tokens":["一起","来","吧"],"reading":"Yīqǐ lái ba","meaning":"Cùng nhau tới nhé."},{"id":"3537644","text":"天气真好 ！","tokens":["天气","真","好"],"reading":"Tiānqì zhēn hǎo","meaning":"Thời tiết thật đẹp!"},{"id":"3537960","text":"我吃过了。","tokens":["我","吃","过","了"],"reading":"Wǒ chī guo le","meaning":"Tôi đã ăn rồi."}]}