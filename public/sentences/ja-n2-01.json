{"id":"ja-n2-01","lang":"ja","level":"N2","index":1,"sentences":[{"id":"107814","text":"彼は穴を掘った。","tokens":["彼","は","穴","を","掘った"],"reading":"かれはあなをほった","ruby":[["彼","かれ"],["は",""],["穴","あな"],["を",""],["掘","ほ"],["った。",""]],"meaning":"Anh ấy đã đào một cái hố."},{"id":"170310","text":"採点しましたか。","tokens":["採点","しました","か"],"reading":"さいてんしましたか","ruby":[["採点","さいてん"],["しましたか。",""]],"meaning":"Bạn chấm bài chưa?"},{"id":"83887","text":"服を着替えなさい。","tokens":["服","を","着替え","なさい"],"reading":"ふくをきがえなさい","ruby":[["服","ふく"],["を",""],["着替","きが"],["えなさい。",""]],"meaning":"Hãy thay quần áo."},{"id":"138158","text":"太陽が西に傾いた。","tokens":["太陽","が","西","に","傾いた"],"reading":"たいようがにしにかたむいた","ruby":[["太陽","たいよう"],["が",""],["西","にし"],["に",""],["傾","かたむ"],["いた。",""]],"meaning":"Mặt trời đã ngả đằng Tây."},{"id":"150919","text":"歯磨きをしなさい。","tokens":["歯磨き","を","し","なさい"],"reading":"はみがきをしなさい","ruby":[["歯磨","はみが"],["きをしなさい。",""]],"meaning":"Đánh răng đi."},{"id":"189526","text":"雨降って地固まる。","tokens":["雨","降って","地","固まる"],"reading":"あめふってじかたまる","ruby":[["雨","あめ"],["降","ふ"],["って",""],["地","じ"],["固","かた"],["まる。",""]],"meaning":"Sau cơn mưa trời lại sáng."},{"id":"105300","text":"彼は時計を分解した。","tokens":["彼","は","時計","を","分解","した"],"reading":"かれはとけいをぶんかいした","ruby":[["彼","かれ"],["は",""],["時計","とけい"],["を",""],["分解","ぶんかい"],["した。",""]],"meaning":"Anh ấy tháo rời chiếc đồng hồ ra."},{"id":"76725","text":"この文の意味は曖昧だ。","tokens":["この","文","の","意味","は","曖昧","だ"],"reading":"このぶんのいみはあいまいだ","ruby":[["この",""],["文","ぶん"],["の",""],["意味","いみ"],["は",""],["曖昧","あいまい"],["だ。",""]],"meaning":"Nghĩa của câu này mơ hồ."},{"id":"78291","text":"率直に話してください。","tokens":["率直に","話して","ください"],"reading":"そっちょくにはなしてください","ruby":[["率直","そっちょく"],["に",""],["話","はな"],["してください。",""]],"meaning":"Hãy nói thẳng với tôi."},{"id":"148404","text":"首相は国会を解散した。","tokens":["首相","は","国会","を","解散","した"],"reading":"しゅしょうはこっかいをかいさんした","ruby":[["首相","しゅしょう"],["は",""],["国会","こっかい"],["を",""],["解散","かいさん"],["した。",""]],"meaning":"Thủ tướng cho giải tán phi