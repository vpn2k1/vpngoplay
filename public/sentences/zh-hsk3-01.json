{"id":"zh-hsk3-01","lang":"zh","level":"HSK3","index":1,"sentences":[{"id":"1409378","text":"雪化了。","tokens":["雪","化","了"],"reading":"Xuě huà le","meaning":"Tuyết tan rồi."},{"id":"3537957","text":"我们也同意。","tokens":["我们","也","同意"],"reading":"Wǒmen yě tóngyì","meaning":"Chúng tôi cũng đồng ý."},{"id":"3710646","text":"他没有白死。","tokens":["他","没有","白","死"],"reading":"Tā méiyǒu bái sǐ","meaning":"Ông ấy không ra đi vô ích."},{"id":"4931168","text":"他胖起来了。","tokens":["他","胖","起来","了"],"reading":"Tā pàng qǐlai le","meaning":"Nó tăng cân rồi."},{"id":"6128504","text":"你需要保护。","tokens":["你","需要","保护"],"reading":"Nǐ xūyào bǎohù","meaning":"Bạn cần được bảo vệ."},{"id":"8696299","text":"来杯咖啡吗？","tokens":["来","杯","咖啡","吗"],"reading":"Lái bēi kāfēi ma","meaning":"Anh dùng thêm một ly cà phê nhé?"},{"id":"343844","text":"我有一台电脑。","tokens":["我","有","一","台","电脑"],"reading":"Wǒ yǒu yī tái diànnǎo","meaning":"Tôi có một chiếc máy vi tính."},{"id":"348176","text":"他赢了三等奬。","tokens":["他","赢","了","三","等","奬"],"reading":"Tā yíng le sān děng jiǎng","meaning":"Anh ấy đã giành được giải ba."},{"id":"371162","text":"你有多少部车？","tokens":["你","有","多少","部","车"],"reading":"Nǐ yǒu duōshao bù chē","meaning":"Ngài có mấy chiếc xe ô tô?"},{"id":"395921","text":"她哭了一整晚。","tokens":["她","哭","了","一","整","晚"],"reading":"Tā kū le yī zhěng wǎn","meaning":"Cô ấy đã khóc suốt đêm."}]}