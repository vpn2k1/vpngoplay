{"id":"zh-hsk2-02","lang":"zh","level":"HSK2","index":2,"sentences":[{"id":"3537973","text":"每人读一段。","tokens":["每人","读","一","段"],"reading":"Měirén dú yī duàn","meaning":"Mỗi người đọc một đoạn."},{"id":"4761402","text":"可是太贵了！","tokens":["可是","太","贵","了"],"reading":"Kěshì tài guì le","meaning":"Nhưng mà nó đắt quá!"},{"id":"5842654","text":"我得去医院。","tokens":["我","得","去","医院"],"reading":"Wǒ de qù yīyuàn","meaning":"Tôi phải đi bệnh viện."},{"id":"8727971","text":"我想选一下。","tokens":["我","想","选","一下"],"reading":"Wǒ xiǎng xuǎn yīxià","meaning":"Tôi muốn chọn một chút."},{"id":"8765060","text":"周一可以吗？","tokens":["周一","可以","吗"],"reading":"Zhōuyī kěyǐ ma","meaning":"Thứ hai OK không?"},{"id":"10699370","text":"你是安全的。","tokens":["你","是","安全","的"],"reading":"Nǐ shì ānquán de","meaning":"Bạn an toàn rồi."},{"id":"11168786","text":"我们没有鱼。","tokens":["我们","没有","鱼"],"reading":"Wǒmen méiyǒu yú","meaning":"Chúng tôi không có cá."},{"id":"2","text":"我该去睡觉了。","tokens":["我","该","去","睡觉","了"],"reading":"Wǒ gāi qù shuìjiào le","meaning":"Tôi phải đi ngủ."},{"id":"3","text":"你在干什麼啊？","tokens":["你","在","干","什麼","啊"],"reading":"Nǐ zài gàn shénme ā","meaning":"Bạn đang làm gì đây?"},{"id":"15","text":"我以前在山里。","tokens":["我","以前","在","山","里"],"reading":"Wǒ yǐqián zài shān lǐ","meaning":"Tôi từ trên núi xuống."}]}