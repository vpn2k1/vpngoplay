{"id":"zh-hsk1-04","lang":"zh","level":"HSK1","index":4,"sentences":[{"id":"4297288","text":"你学得很快。","tokens":["你","学","得很","快"],"reading":"Nǐ xué dehěn kuài","meaning":"Bạn học rất nhanh."},{"id":"4297298","text":"不关我的事。","tokens":["不","关","我","的","事"],"reading":"Bù guān wǒ de shì","meaning":"Không phải chuyện của tôi."},{"id":"7768300","text":"你在看什么？","tokens":["你","在","看","什么"],"reading":"Nǐ zài kàn shénme","meaning":"Bạn đang nhìn cái gì thế?"},{"id":"9007280","text":"现在五点钟.","tokens":["现在","五","点钟"],"reading":"Xiànzài wǔ diǎnzhōng","meaning":"Hiện tại là năm giờ."},{"id":"12993361","text":"一，二，三，四，五。","tokens":["一","二","三","四","五"],"reading":"Yī èr sān sì wǔ","meaning":"Một, hai, ba, bốn, năm."},{"id":"330583","text":"我真的不知道。","tokens":["我","真","的","不","知道"],"reading":"Wǒ zhēn de bù zhīdào","meaning":"Tôi thật sự không biết."},{"id":"335851","text":"这是没办法的。","tokens":["这","是","没办法","的"],"reading":"Zhè shì méibànfǎ de","meaning":"Vụ này hết cách rồi."},{"id":"340476","text":"你会说法语吗？","tokens":["你","会","说","法语","吗"],"reading":"Nǐ huì shuō Fǎyǔ ma","meaning":"Cậu có biết nói tiếng Pháp không?"},{"id":"397199","text":"你喜欢唱歌吗？","tokens":["你","喜欢","唱歌","吗"],"reading":"Nǐ xǐhuan chànggē ma","meaning":"Bạn thích hát không?"},{"id":"429099","text":"他六点回来了。","tokens":["他","六","点","回来","了"],"reading":"Tā liù diǎn huílai le","meaning":"Anh ta quay trở lại vào lúc 6 giờ."}]}