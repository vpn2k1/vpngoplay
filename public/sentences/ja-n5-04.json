{"id":"ja-n5-04","lang":"ja","level":"N5","index":4,"sentences":[{"id":"187561","text":"何を言ってるの！","tokens":["何","を","言ってる","の"],"reading":"なにをいってるの","ruby":[["何","なに"],["を",""],["言","い"],["ってるの！",""]],"meaning":"Bạn nói gì đấy?"},{"id":"187971","text":"何が言いたいの？","tokens":["何","が","言い","たい","の"],"reading":"なにがいいたいの","ruby":[["何","なに"],["が",""],["言","い"],["いたいの？",""]],"meaning":"Bạn muốn nói gì?"},{"id":"195435","text":"まだ時間がある。","tokens":["まだ","時間","が","ある"],"reading":"まだじかんがある","ruby":[["まだ",""],["時間","じかん"],["がある。",""]],"meaning":"Vẫn còn thời gian."},{"id":"205604","text":"それは何ですか。","tokens":["それ","は","何","ですか"],"reading":"それはなんですか","ruby":[["それは",""],["何","なん"],["ですか。",""]],"meaning":"Cái này là gì?"},{"id":"221437","text":"この写真大好き。","tokens":["この","写真","大好き"],"reading":"このしゃしんだいすき","ruby":[["この",""],["写真","しゃしん"],["大好","だいす"],["き。",""]],"meaning":"Tôi rất thích bức ảnh này."},{"id":"224557","text":"ここで止まるな。","tokens":["ここ","で","止まる","な"],"reading":"ここでとまるな","ruby":[["ここで",""],["止","と"],["まるな。",""]],"meaning":"Đừng dừng lại ở đây."},{"id":"227004","text":"お水をください。","tokens":["お","水","を","ください"],"reading":"おみずをください","ruby":[["お",""],["水","みず"],["をください。",""]],"meaning":"Cho tôi xin ít nước."},{"id":"231111","text":"あの鞄が欲しい。","tokens":["あの","鞄","が","欲しい"],"reading":"あのかばんがほしい","ruby":[["あの",""],["鞄","かばん"],["が",""],["欲","ほ"],["しい。",""]],"meaning":"Tôi muốn cái cặp đó."},{"id":"236806","text":"私は本を売った。","tokens":["私","は","本","を","売った"],"reading":"わたしはほんをうった","ruby":[["私","わたし"],["は",""],["本","ほん"],["を",""],["売","う"],["った。",""]],"meaning":"Tôi đã bán sách."},{"id":"4715","text":"私は山にいました。","tokens":["私","は","山","に","いました"],"reading":"わたしはやまにいました","ruby":[["私","わたし"],["は",""],["山","やま"],["にいました。",""]],"meaning":"Tôi từ trên núi xuống."}]}