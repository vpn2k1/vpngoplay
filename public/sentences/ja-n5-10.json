{"id":"ja-n5-10","lang":"ja","level":"N5","index":10,"sentences":[{"id":"162840","text":"私の父は銀行員です。","tokens":["私の","父","は","銀行員","です"],"reading":"わたしのちちはぎんこういんです","ruby":[["私","わたし"],["の",""],["父","ちち"],["は",""],["銀行員","ぎんこういん"],["です。",""]],"meaning":"Bố tôi là một nhân viên ngân hàng."},{"id":"170874","text":"砂糖を取って下さい。","tokens":["砂糖","を","取って","下さい"],"reading":"さとうをとってください","ruby":[["砂糖","さとう"],["を",""],["取","と"],["って",""],["下","くだ"],["さい。",""]],"meaning":"Hãy lấy cho tôi lọ đường."},{"id":"174534","text":"戸を閉めてください。","tokens":["戸","を","閉めて","ください"],"reading":"とをしめてください","ruby":[["戸","と"],["を",""],["閉","し"],["めてください。",""]],"meaning":"Hãy đóng cửa."},{"id":"187535","text":"何を料理しているの。","tokens":["何","を","料理","している","の"],"reading":"なにをりょうりしているの","ruby":[["何","なに"],["を",""],["料理","りょうり"],["しているの。",""]],"meaning":"Bạn đang nấu gì thế?"},{"id":"189741","text":"雨が降り出しそうだ。","tokens":["雨","が","降り出しそう","だ"],"reading":"あめがふりだしそうだ","ruby":[["雨","あめ"],["が",""],["降","ふ"],["り",""],["出","だ"],["しそうだ。",""]],"meaning":"Chắc có lẽ trời sắp mưa rồi."},{"id":"191025","text":"椅子の下にあります。","tokens":["椅子","の","下","に","あります"],"reading":"いすのしたにあります","ruby":[["椅子","いす"],["の",""],["下","した"],["にあります。",""]],"meaning":"Nó ở dưới cái ghế."},{"id":"195463","text":"まだ何も知りません。","tokens":["まだ","何も","知りません"],"reading":"まだなにもしりません","ruby":[["まだ",""],["何","なに"],["も",""],["知","し"],["りません。",""]],"meaning":"Tôi vẫn chưa biết gì cả."},{"id":"219743","text":"この本の方が小さい。","tokens":["この","本","の","方","が","小さい"],"reading":"このほんのほうがちいさい","ruby":[["この",""],["本","ほん"],["の",""],["方","ほう"],["が",""],["小","ちい"],["さい。",""]],"meaning":"Quyển sách này nhỏ hơn."},{"id":"221397","text":"この車は最新型です。","tokens":["この","車","は","最新型","です"],"reading":"このくるまはさいしんがたです","ruby":[["この",""],["車","くるま"],["は",""],["最新","さいしん"],["型","がた"],["です。",""]],"meaning":"Chiếc xe hơi này là mẫu mới nhất."},{"id":"224847","text":"コーヒー飲みますか。","tokens":["コーヒー","飲みます","か"],"reading":"コーヒーのみますか","ruby":[["コーヒー",""],["飲","の"],["みますか。",""]],"meaning":"Anh u