:"Tranh tường"}],"sentences":[{"id":"s1","tokens":["He","presented","me","with","a","bouquet","of","flowers"],"meaning":"Anh ấy đã tặng tôi một bó hoa."},{"id":"s2","tokens":["There","is","no","use","trying","to","excuse","yourself"],"meaning":"Có bào chữa thì cũng vô dụng thôi."},{"id":"s3","tokens":["I","don't","have","the","stamina","to","do","that"],"meaning":"Tôi không có sức chịu đựng để làm điều đó."},{"id":"s4","tokens":["The","reception","on","this","portable","TV","is","terrible"],"meaning":"Khả năng thu tín hiệu trên chiếc tivi di động này thật tệ."},{"id":"s5","tokens":["Who","left","all","this","clutter","on","the","floor"],"meaning":"Ai đã để đống đồ lộn xộn này trên sàn vậy?"}]}
