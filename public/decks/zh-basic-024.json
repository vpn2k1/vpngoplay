{"id":"zh-basic-024","lang":"zh","course":"zh-basic","lesson":24,"draft":true,"level":"HSK1–HSK4","title":"Cơ bản · Bài 24","description":"洗手间 · 下课 · 请假 · 米饭 …","words":[{"id":"w01","term":"洗手间","reading":"xǐshǒujiān","meaning":"phòng rửa mặt","emoji":"🚽","example":"我们来学“洗手间”这个词。","exampleMeaning":"Cùng học từ “洗手间”: phòng rửa mặt."},{"id":"w02","term":"下课","reading":"xiàkè","meaning":"tan học","example":"我们来学“下课”这个词。","exampleMeaning":"Cùng học từ “下课”: tan học."},{"id":"w03","term":"请假","reading":"qǐngjià","meaning":"xin nghỉ","example":"因病请假一天。","exampleMeaning":"Vì bệnh xin nghỉ một ngày."},{"id":"w04","term":"米饭","reading":"mǐfàn","meaning":"cơm tẻ","example":"我们来学“米饭”这个词。","exampleMeaning":"Cùng học từ “米饭”: cơm tẻ."},{"id":"w05","term":"里边","reading":"lǐbian","meaning":"trong","example":"他一年里边没有请过一次假。","exampleMeaning":"Suốt cả năm cậu ấy chẳng xin nghỉ ngày nào cả."},{"id":"w06","term":"外语","reading":"wàiyǔ","meaning":"tiếng nước ngoài","example":"我们来学“外语”这个词。","exampleMeaning":"Cùng học từ “外语”: tiếng nước ngoài."},{"id":"w07","term":"没事儿","reading":"méishìr","meaning":"thời gian rảnh","example":"我们来学“没事儿”这个词。","exampleMeaning":"Cùng học từ “没事儿”: thời gian rảnh."},{"id":"w08","term":"一块儿","reading":"yīkuàir","meaning":"cùng","example":"他们一块儿参军。","exampleMeaning":"Họ cùng đi nghĩa vụ."},{"id":"w09","term":"书包","reading":"shūbāo","meaning":"túi sách","example":"我们来学“书包”这个词。","exampleMeaning":"Cùng học từ “书包”: túi sách."},{"id":"w10","term":"小学生","reading":"xiǎoxuéshēng","meaning":"học trò nhỏ","example":"我们来学“小学生”这个词。","exampleMeaning":"Cùng học từ “小学生”: học trò nhỏ."},{"id":"w11","term":"外边","reading":"wàibian","meaning":"ngoài","example":"院子外边新栽了一些树。","exampleMeaning":"Ngoài sân trồng một số cây ăn quả mới."},{"id":"w12","term":"中学生","reading":"zhōngxuéshēng","meaning":"học sinh trung học","example":"我们来学“中学生”这个词。","exampleMeaning":"Cùng học từ “中学生”: học sinh trung học."},{"id":"w13","term":"本子","reading":"běnzi","meaning":"vở","example":"改本子（评改作业）","exampleMeaning":"Sửa vở bài tập"},{"id":"w14","term":"课本","reading":"kèběn","meaning":"sách giáo khoa, sách học, điển hình","example":"数学课本。","exampleMeaning":"Sách toán."},{"id":"w15","term":"后边","reading":"hòubian","meaning":"phía sau","example":"我们来学“后边”这个词。","exampleMeaning":"Cùng học từ “后边”: phía sau."},{"id":"w16","term":"西边","reading":"xībiān","meaning":"phía tây","example":"我们来学“西边”这个词。","exampleMeaning":"Cùng học từ “西边”: phía tây."},{"id":"w17","term":"上边","reading":"shàngbian","meaning":"bên trên","example":"我们来学“上边”这个词。","exampleMeaning":"Cùng học từ “上边”: bên trên."},{"id":"w18","term":"打车","reading":"dǎchē","meaning":"bắt xe, gọi xe taxi","example":"我们来学“打车”这个词。","exampleMeaning":"Cùng học từ “打车”: bắt xe, gọi xe taxi."},{"id":"w19","term":"东边","reading":"dōngbian","meaning":"đông","example":"我们来学“东边”这个词。","exampleMeaning":"Cùng học từ “东边”: đông."},{"id":"w20","term":"包子","reading":"bāozi","meaning":"bánh bao","example":"我们来学“包子”这个词。","exampleMeaning":"Cùng học từ “包子”: bánh bao."}],"sentences":[{"id":"s1","tokens":["我","不","知道"],"reading":"wǒ bù zhīdào","meaning":"Tôi không biết."},{"id":"s2","tokens":["不","要","担心"],"reading":"bù yào dānxīn","meaning":"Đừng lo."},{"id":"s3","tokens":["那","又","怎样"],"reading":"nà yòu zěnyàng","meaning":"Thì sao?"},{"id":"s4","tokens":["我","吃","过","了"],"reading":"wǒ chī guo le","meaning":"Tôi đã ăn rồi."},{"id":"s5","tokens":["好","疼","停下"],"reading":"hǎo téng tíngxià","meaning":"Đau quá! Dừng lại!"}]}
