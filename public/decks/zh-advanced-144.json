{"id":"zh-advanced-144","lang":"zh","course":"zh-advanced","lesson":144,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 144","description":"必不可少 · 新式 · 倘若 · 烟囱 …","words":[{"id":"w01","term":"必不可少","reading":"bìbùkěshǎo","meaning":"không thể thiếu, thiết yếu","example":"食品是人人必不可少的。","exampleMeaning":"Thực phẩm là thứ không thể thiếu của con người."},{"id":"w02","term":"新式","reading":"xīnshì","meaning":"kiểu mới, mới","example":"新式农具。","exampleMeaning":"Nông cụ kiểu mới"},{"id":"w03","term":"倘若","reading":"tǎngruò","meaning":"nếu, giả sử","example":"你倘若不信，就亲自去看看吧。","exampleMeaning":"Nếu anh không tin, thì tự đi xem thử."},{"id":"w04","term":"烟囱","reading":"yāncōng","meaning":"ống khói","example":"我们来学“烟囱”这个词。","exampleMeaning":"Cùng học từ “烟囱”: ống khói."},{"id":"w05","term":"湿度","reading":"shīdù","meaning":"độ ẩm","example":"土壤的湿度。","exampleMeaning":"Độ ẩm của nước."},{"id":"w06","term":"素食","reading":"sùshí","meaning":"đồ chay, ăn chay","example":"素食者(长期吃素的人)。","exampleMeaning":"Người ăn chay (người ăn chay trường)."},{"id":"w07","term":"报废","reading":"bàofèi","meaning":"thải bỏ, thanh lý","example":"这批零件全部报废。","exampleMeaning":"Toàn bộ lô linh kiện này bị báo hư."},{"id":"w08","term":"纺织","reading":"fǎngzhī","meaning":"dệt, dệt may","example":"纺织工艺","exampleMeaning":"Công nghệ dệt."},{"id":"w09","term":"丑恶","reading":"chǒuè","meaning":"xấu xa, ghê tởm","example":"丑恶嘴脸。","exampleMeaning":"Bôi nhọ mặt mũi."},{"id":"w10","term":"闹事","reading":"nàoshì","meaning":"gây rối, gây chuyện","example":"我们来学“闹事”这个词。","exampleMeaning":"Cùng học từ “闹事”: gây rối, gây chuyện."},{"id":"w11","term":"年薪","reading":"niánxīn","meaning":"lương năm","example":"我们来学“年薪”这个词。","exampleMeaning":"Cùng học từ “年薪”: lương năm."},{"id":"w12","term":"梯子","reading":"tīzi","meaning":"cái thang","emoji":"🪜","example":"我们来学“梯子”这个词。","exampleMeaning":"Cùng học từ “梯子”: cái thang."},{"id":"w13","term":"剧目","reading":"jùmù","meaning":"vở diễn, tiết mục","example":"今天上演什么剧目？","exampleMeaning":"Hôm nay có vở gì?"},{"id":"w14","term":"纪念馆","reading":"jìniànguǎn","meaning":"nhà tưởng niệm, bảo tàng kỷ niệm","example":"上海 有鲁迅纪念馆。","exampleMeaning":"Ở Thượng Hải có nhà kỉ niệm Lỗ Tấn"},{"id":"w15","term":"家用","reading":"jiāyòng","meaning":"gia dụng, chi tiêu gia đình","example":"贴补家用。","exampleMeaning":"Phụ cấp sinh hoạt gia đình."},{"id":"w16","term":"准许","reading":"zhǔnxǔ","meaning":"cho phép, chuẩn y","example":"准许办理出境手续。","exampleMeaning":"Cho phép làm thủ tục xuất cảnh."},{"id":"w17","term":"盖子","reading":"gàizi","meaning":"nắp, vung","example":"茶杯盖子碎了。","exampleMeaning":"Nắp tách trà bị vỡ rồi."},{"id":"w18","term":"简陋","reading":"jiǎnlòu","meaning":"sơ sài, đơn sơ","example":"简陋的住所","exampleMeaning":"Chỗ ở sơ sài"},{"id":"w19","term":"重叠","reading":"chóngdié","meaning":"chồng chéo, trùng lặp","example":"精简重叠的机构。","exampleMeaning":"Tinh giảm những cơ cấu trùng lặp."},{"id":"w20","term":"压倒","reading":"yādǎo","meaning":"áp đảo, lấn át","example":"困难决不会压倒我们。","exampleMeaning":"Khó khăn không thể áp đảo được chúng tôi."}],"sentences":[{"id":"s1","tokens":["突然","天下","起","雨","来"],"reading":"tūrán tiānxià qǐ yǔ lái","meaning":"Bỗng nhiên trời mưa."},{"id":"s2","tokens":["哪","间","卧室","都","干净"],"reading":"nǎ jiān wòshì dōu gānjìng","meaning":"Phòng ngủ nào cũng sạch sẽ."},{"id":"s3","tokens":["沸水","蒸发","成","气体"],"reading":"fèishuǐ zhēngfā chéng qìtǐ","meaning":"Nước sôi bốc thành hơi."},{"id":"s4","tokens":["呻吟","未","止","忘","良医"],"reading":"shēnyín wèi zhǐ wàng liángyī","meaning":"Chưa khỏi rên đã quên thầy."},{"id":"s5","tokens":["她","经受","得","够","多","了"],"reading":"tā jīngshòu de gòu duō le","meaning":"Nó đã trải qua rất nhiều chuyện rồi."}]}
