 word \"avid\".","exampleMeaning":"Cùng học từ “avid”: khao khát, thèm khát, thèm thuồng."}],"sentences":[{"id":"s1","tokens":["Machine","learning","demands","a","lot","of","computation"],"meaning":"Học máy yêu cầu rất nhiều sức mạnh tính toán."},{"id":"s2","tokens":["We're","becoming","too","conceited"],"meaning":"Chúng ta đang trở nên quá tự phụ."},{"id":"s3","tokens":["He","assembles","washing","machines"],"meaning":"Cậu ấy lấp ráp máy giặt."},{"id":"s4","tokens":["She","is","an","interpreter"],"meaning":"Chị ấy là phiên dịch viên."},{"id":"s5","tokens":["I'll","be","your","roommate"],"meaning":"Tôi sẽ là bạn cùng phòng của bạn."}]}
