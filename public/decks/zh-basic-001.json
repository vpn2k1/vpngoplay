{"id":"zh-basic-001","lang":"zh","course":"zh-basic","lesson":1,"level":"HSK1–HSK4","title":"Cơ bản · Bài 1","description":"的 · 了 · 我 · 是 …","words":[{"id":"w01","term":"的","reading":"de","meaning":"của (trợ từ sở hữu)","example":"这是我的书。","exampleMeaning":"Đây là sách của tôi."},{"id":"w02","term":"了","reading":"le","meaning":"rồi, đã","example":"我吃饭了。","exampleMeaning":"Tôi ăn cơm rồi."},{"id":"w03","term":"我","reading":"wǒ","meaning":"tôi, tớ","example":"我是学生。","exampleMeaning":"Tôi là học sinh."},{"id":"w04","term":"是","reading":"shì","meaning":"là, đúng","example":"他是老师。","exampleMeaning":"Anh ấy là giáo viên."},{"id":"w05","term":"你","reading":"nǐ","meaning":"bạn","example":"你好吗？","exampleMeaning":"Bạn khỏe không?"},{"id":"w06","term":"在","reading":"zài","meaning":"ở, đang","example":"我在家。","exampleMeaning":"Tôi ở nhà."},{"id":"w07","term":"不","reading":"bù","meaning":"không","example":"我不喝茶。","exampleMeaning":"Tôi không uống trà."},{"id":"w08","term":"有","reading":"yǒu","meaning":"có","example":"我有一个哥哥。","exampleMeaning":"Tôi có một anh trai."},{"id":"w09","term":"他","reading":"tā","meaning":"anh ấy, ông ấy","example":"他很高。","exampleMeaning":"Anh ấy rất cao."},{"id":"w10","term":"这","reading":"zhè","meaning":"này, đây","example":"这个很好吃。","exampleMeaning":"Cái này rất ngon."},{"id":"w11","term":"就","reading":"jiù","meaning":"thì, ngay, liền","example":"我马上就来。","exampleMeaning":"Tôi đến ngay."},{"id":"w12","term":"个","reading":"gè","meaning":"cái, chiếc (lượng từ)","example":"我买了三个苹果。","exampleMeaning":"Tôi đã mua ba quả táo."},{"id":"w13","term":"和","reading":"hé","meaning":"và, với","example":"我和妈妈去商店。","exampleMeaning":"Tôi và mẹ đi cửa hàng."},{"id":"w14","term":"人","reading":"rén","meaning":"người","emoji":"🧑","example":"他是中国人。","exampleMeaning":"Anh ấy là người Trung Quốc."},{"id":"w15","term":"说","reading":"shuō","meaning":"nói","emoji":"🗣️","example":"请再说一遍。","exampleMeaning":"Xin hãy nói lại một lần nữa."},{"id":"w16","term":"我们","reading":"wǒmen","meaning":"chúng tôi, chúng ta","example":"我们一起走吧。","exampleMeaning":"Chúng ta cùng đi nhé."},{"id":"w17","term":"要","reading":"yào","meaning":"muốn, cần","example":"我要一杯水。","exampleMeaning":"Tôi muốn một cốc nước."},{"id":"w18","term":"好","reading":"hǎo","meaning":"tốt, hay","emoji":"👍","example":"今天天气很好。","exampleMeaning":"Hôm nay thời tiết rất tốt."},{"id":"w19","term":"一","reading":"yī","meaning":"một","example":"我有一本书。","exampleMeaning":"Tôi có một quyển sách."},{"id":"w20","term":"会","reading":"huì","meaning":"biết (làm), sẽ","example":"我会说汉语。","exampleMeaning":"Tôi biết nói tiếng Trung."}],"sentences":[{"id":"s1","tokens":["我","是","中国","人"],"reading":"wǒ shì Zhōngguó rén","meaning":"Tôi là người Trung Quốc."},{"id":"s2","tokens":["你","要","不","要","喝","茶"],"reading":"nǐ yào bu yào hē chá","meaning":"Bạn có muốn uống trà không?"},{"id":"s3","tokens":["我们","会","说","汉语"],"reading":"wǒmen huì shuō Hànyǔ","meaning":"Chúng tôi biết nói tiếng Trung."},{"id":"s4","tokens":["他","有","一","个","好","朋友"],"reading":"tā yǒu yí gè hǎo péngyou","meaning":"Anh ấy có một người bạn tốt."},{"id":"s5","tokens":["这","是","我","和","他","的","书"],"reading":"zhè shì wǒ hé tā de shū","meaning":"Đây là sách của tôi và anh ấy."}]}
