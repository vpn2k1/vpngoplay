{"id":"zh-intermediate-002","lang":"zh","course":"zh-intermediate","lesson":2,"draft":true,"level":"HSK4–HSK7-9","title":"Trung cấp · Bài 2","description":"培育 · 导游 · 轮椅 · 小吃 …","words":[{"id":"w01","term":"培育","reading":"péiyù","meaning":"đào tạo","emoji":"🚆","example":"选择优良品种，进行培育。","exampleMeaning":"Chọn giống tốt, tiến hành gây trồng."},{"id":"w02","term":"导游","reading":"dǎoyóu","meaning":"hướng dẫn du lịch","example":"《西湖导游》“","exampleMeaning":"Hướng dẫn du lịch Tây Hồ”"},{"id":"w03","term":"轮椅","reading":"lúnyǐ","meaning":"xe đẩy","example":"我们来学“轮椅”这个词。","exampleMeaning":"Cùng học từ “轮椅”: xe đẩy."},{"id":"w04","term":"小吃","reading":"xiǎochī","meaning":"hàng quà bánh","example":"经济小吃。","exampleMeaning":"Món ăn rẻ tiền."},{"id":"w05","term":"叶子","reading":"yèzi","meaning":"lá cây","example":"我们来学“叶子”这个词。","exampleMeaning":"Cùng học từ “叶子”: lá cây."},{"id":"w06","term":"打折","reading":"dǎzhé","meaning":"bán giảm giá, chiết khấu, sale","example":"我们来学“打折”这个词。","exampleMeaning":"Cùng học từ “打折”: bán giảm giá, chiết khấu, sale."},{"id":"w07","term":"改正","reading":"gǎizhèng","meaning":"sửa","example":"改正错别字。","exampleMeaning":"Sửa những chữ sai và chữ viết lẫn."},{"id":"w08","term":"特价","reading":"tèjià","meaning":"giá đặc biệt","example":"特价出售","exampleMeaning":"Bán giá đặc biệt; khuyến mãi."},{"id":"w09","term":"鲜明","reading":"xiānmíng","meaning":"tươi sáng (màu sắc)","example":"鲜明的阶级立场。","exampleMeaning":"Lập trường giai cấp rõ ràng。"},{"id":"w10","term":"延期","reading":"yánqī","meaning":"kéo dài thời hạn","example":"我们来学“延期”这个词。","exampleMeaning":"Cùng học từ “延期”: kéo dài thời hạn."},{"id":"w11","term":"爱护","reading":"àihù","meaning":"bảo vệ","example":"爱护公物。","exampleMeaning":"Bảo vệ của công"},{"id":"w12","term":"黄瓜","reading":"huángguā","meaning":"dây dưa chuột","emoji":"🥒","example":"我们来学“黄瓜”这个词。","exampleMeaning":"Cùng học từ “黄瓜”: dây dưa chuột."},{"id":"w13","term":"堵车","reading":"dǔchē","meaning":"kẹt xe","example":"上下班时间，这个路口经常堵车。","exampleMeaning":"Lúc vào ca và tan ca, đường này thường xuyên kẹt xe."},{"id":"w14","term":"暖气","reading":"nuǎnqì","meaning":"hệ thống sưởi hơi","example":"我们来学“暖气”这个词。","exampleMeaning":"Cùng học từ “暖气”: hệ thống sưởi hơi."},{"id":"w15","term":"二手","reading":"èrshǒu","meaning":"second hand","example":"我们来学“二手”这个词。","exampleMeaning":"Cùng học từ “二手”: second hand."},{"id":"w16","term":"味儿","reading":"wèir","meaning":"vị","example":"我们来学“味儿”这个词。","exampleMeaning":"Cùng học từ “味儿”: vị."},{"id":"w17","term":"优良","reading":"yōuliáng","meaning":"tốt","example":"优良的传统。","exampleMeaning":"Truyền thống tốt đẹp"},{"id":"w18","term":"转弯","reading":"zhuǎnwān","meaning":"rẽ","example":"这儿离学校很近，一转弯儿就到了。","exampleMeaning":"Ở đây gần trường lắm, chỉ rẽ một cái là đến."},{"id":"w19","term":"期末","reading":"qīmò","meaning":"cuối kì","example":"我们来学“期末”这个词。","exampleMeaning":"Cùng học từ “期末”: cuối kì."},{"id":"w20","term":"方针","reading":"fāngzhēn","meaning":"phương châm","example":"方针政策","exampleMeaning":"Phương châm chính sách"}],"sentences":[{"id":"s1","tokens":["他","让步","了"],"reading":"tā ràngbù le","meaning":"Anh ta đã nhượng bộ."},{"id":"s2","tokens":["我","很","谦虚"],"reading":"wǒ hěn qiānxū","meaning":"Tôi rất khiêm tốn."},{"id":"s3","tokens":["你","很","害羞"],"reading":"nǐ hěn hàixiū","meaning":"Bạn rất nhút nhát."},{"id":"s4","tokens":["你","非常","勇敢"],"reading":"nǐ fēicháng yǒnggǎn","meaning":"Bạn rất dũng cảm."},{"id":"s5","tokens":["竞赛","是","爱国"],"reading":"jìngsài shì àiguó","meaning":"Thi đua là yêu nước."}]}
