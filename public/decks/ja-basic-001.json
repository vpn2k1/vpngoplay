{"id":"ja-basic-001","lang":"ja","course":"ja-basic","lesson":1,"level":"N5–N3","title":"Cơ bản · Bài 1","description":"来年 · 本 · すぐに · 話 …","words":[{"id":"w01","term":"来年","reading":"らいねん · rainen","meaning":"năm sau, năm tới","example":"来年、日本へ行きます。","exampleMeaning":"Năm sau tôi sẽ đi Nhật."},{"id":"w02","term":"本","reading":"ほん · hon","meaning":"sách, quyển sách","emoji":"📖","example":"この本はおもしろいです。","exampleMeaning":"Quyển sách này thú vị."},{"id":"w03","term":"すぐに","reading":"suguni","meaning":"ngay lập tức, ngay","example":"すぐに行きます。","exampleMeaning":"Tôi sẽ đi ngay."},{"id":"w04","term":"話","reading":"はなし · hanashi","meaning":"câu chuyện, cuộc nói chuyện","example":"先生の話を聞きます。","exampleMeaning":"Tôi nghe câu chuyện của thầy giáo."},{"id":"w05","term":"お茶","reading":"おちゃ · ocha","meaning":"trà","emoji":"🍵","example":"お茶を飲みませんか。","exampleMeaning":"Bạn uống trà không?"},{"id":"w06","term":"生まれる","reading":"うまれる · umareru","meaning":"được sinh ra, ra đời","example":"もうすぐ子どもが生まれる。","exampleMeaning":"Đứa bé sắp ra đời."},{"id":"w07","term":"八つ","reading":"やっつ · yattsu","meaning":"tám cái","example":"りんごが八つあります。","exampleMeaning":"Có tám quả táo."},{"id":"w08","term":"疲れる","reading":"つかれる · tsukareru","meaning":"mệt, mệt mỏi","example":"長い仕事は疲れる。","exampleMeaning":"Làm việc lâu thì mệt."},{"id":"w09","term":"借りる","reading":"かりる · kariru","meaning":"mượn, vay","example":"図書館で本を借りる。","exampleMeaning":"Tôi mượn sách ở thư viện."},{"id":"w10","term":"段々","reading":"だんだん · dandan","meaning":"dần dần","example":"段々暖かくなります。","exampleMeaning":"Trời ấm dần lên."},{"id":"w11","term":"映画","reading":"えいが · eiga","meaning":"phim, bộ phim","emoji":"🎬","example":"映画を見に行きましょう。","exampleMeaning":"Chúng ta đi xem phim nhé."},{"id":"w12","term":"姉","reading":"あね · ane","meaning":"chị gái (của mình)","example":"姉は銀行で働いています。","exampleMeaning":"Chị gái tôi làm việc ở ngân hàng."},{"id":"w13","term":"これ","reading":"kore","meaning":"cái này","example":"これは何ですか。","exampleMeaning":"Cái này là gì?"},{"id":"w14","term":"飛ぶ","reading":"とぶ · tobu","meaning":"bay","emoji":"🕊️","example":"鳥が空を飛ぶ。","exampleMeaning":"Chim bay trên bầu trời."},{"id":"w15","term":"あっち","reading":"atchi","meaning":"đằng kia, phía kia","example":"駅はあっちです。","exampleMeaning":"Nhà ga ở đằng kia."},{"id":"w16","term":"仕事","reading":"しごと · shigoto","meaning":"công việc","emoji":"💼","example":"仕事は何時に終わりますか。","exampleMeaning":"Công việc kết thúc lúc mấy giờ?"},{"id":"w17","term":"丈夫","reading":"じょうぶ · joubu","meaning":"chắc chắn, bền, khỏe mạnh","example":"このかばんは丈夫です。","exampleMeaning":"Cái túi này rất bền."},{"id":"w18","term":"御飯","reading":"ごはん · gohan","meaning":"cơm, bữa ăn","emoji":"🍚","example":"御飯を食べましたか。","exampleMeaning":"Bạn đã ăn cơm chưa?"},{"id":"w19","term":"妹","reading":"いもうと · imouto","meaning":"em gái","example":"妹は十歳です。","exampleMeaning":"Em gái tôi mười tuổi."},{"id":"w20","term":"上げる","reading":"あげる · ageru","meaning":"nâng lên, giơ lên","example":"手を上げる。","exampleMeaning":"Giơ tay lên."}],"sentences":[{"id":"s1","tokens":["姉","は","映画","が","好き","です"],"reading":"あねはえいががすきです","meaning":"Chị gái tôi thích phim."},{"id":"s2","tokens":["妹","に","本","を","借りました"],"reading":"いもうとにほんをかりました","meaning":"Tôi đã mượn sách của em gái."},{"id":"s3","tokens":["来年","子ども","が","生まれます"],"reading":"らいねんこどもがうまれます","meaning":"Năm sau con tôi sẽ ra đời."},{"id":"s4","tokens":["御飯","の","後","で","お茶","を","飲みます"],"reading":"ごはんのあとでおちゃをのみます","meaning":"Sau bữa ăn tôi uống trà."},{"id":"s5","tokens":["仕事","が","段々","楽しく","なります"],"reading":"しごとがだんだんたのしくなります","meaning":"Công việc dần dần trở nên vui hơn."}]}
