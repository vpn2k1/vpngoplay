ences":[{"id":"s1","tokens":["I've","been","tormented","by","regret"],"meaning":"Tôi đã bị dằn vặt bởi sự hối hận."},{"id":"s2","tokens":["I'm","trying","to","learn","English"],"meaning":"Tôi đang cố gắng học tiếng Anh."},{"id":"s3","tokens":["We're","all","trying","to","win"],"meaning":"Tất cả chúng ta đều cố gắng để chiến thắng."},{"id":"s4","tokens":["He","did","it","without","malice"],"meaning":"Anh ấy không cố ý làm việc đó."},{"id":"s5","tokens":["She","reconciled","with","her","friend"],"meaning":"Cô ấy đã hòa giải với người bạn của mình."}]}
