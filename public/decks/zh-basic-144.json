{"id":"zh-basic-144","lang":"zh","course":"zh-basic","lesson":144,"draft":true,"level":"HSK1–HSK4","title":"Cơ bản · Bài 144","description":"瓜 · 语音 · 图案 · 准时 …","words":[{"id":"w01","term":"瓜","reading":"guā","meaning":"dưa tây","emoji":"🍈","example":"我们来学“瓜”这个词。","exampleMeaning":"Cùng học từ “瓜”: dưa tây."},{"id":"w02","term":"语音","reading":"yǔyīn","meaning":"ngữ âm","example":"我们来学“语音”这个词。","exampleMeaning":"Cùng học từ “语音”: ngữ âm."},{"id":"w03","term":"图案","reading":"túàn","meaning":"đồ án","example":"我们来学“图案”这个词。","exampleMeaning":"Cùng học từ “图案”: đồ án."},{"id":"w04","term":"准时","reading":"zhǔnshí","meaning":"đúng giờ","example":"我们的飞机准时到达。","exampleMeaning":"Máy bay của chúng ta đã đến đúng giờ."},{"id":"w05","term":"纪律","reading":"jìlǜ","meaning":"kỷ luật","example":"劳动纪律","exampleMeaning":"Kỷ luật lao động"},{"id":"w06","term":"闪电","reading":"shǎndiàn","meaning":"chớp","example":"我们来学“闪电”这个词。","exampleMeaning":"Cùng học từ “闪电”: chớp."},{"id":"w07","term":"打扫","reading":"dǎsǎo","meaning":"thu dọn","example":"打扫院子","exampleMeaning":"Quét sân"},{"id":"w08","term":"上个月","reading":"shànggèyuè","meaning":"tháng trước","example":"我们来学“上个月”这个词。","exampleMeaning":"Cùng học từ “上个月”: tháng trước."},{"id":"w09","term":"童话","reading":"tónghuà","meaning":"đồng thoại","example":"我们来学“童话”这个词。","exampleMeaning":"Cùng học từ “童话”: đồng thoại."},{"id":"w10","term":"得意","reading":"déyì","meaning":"đắc ý","example":"得意门生","exampleMeaning":"Hài lòng về học trò"},{"id":"w11","term":"手套","reading":"shǒutào","meaning":"găng tay","example":"我们来学“手套”这个词。","exampleMeaning":"Cùng học từ “手套”: găng tay."},{"id":"w12","term":"记载","reading":"jìzǎi","meaning":"ghi chép","example":"我读过一篇当时写下的记载。","exampleMeaning":"Tôi đã đọc qua bài ghi chép viết lúc ấy."},{"id":"w13","term":"毕业生","reading":"bìyèshēng","meaning":"sinh viên tốt nghiệp","example":"大学毕业生。","exampleMeaning":"Sinh viên tốt nghiệp đại học"},{"id":"w14","term":"总共","reading":"zǒnggòng","meaning":"tổng cộng","example":"我们场里总共