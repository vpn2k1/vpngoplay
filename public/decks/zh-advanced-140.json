{"id":"zh-advanced-140","lang":"zh","course":"zh-advanced","lesson":140,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 140","description":"乞讨 · 剧团 · 转折 · 新颖 …","words":[{"id":"w01","term":"乞讨","reading":"qǐtǎo","meaning":"ăn mày","example":"我们来学“乞讨”这个词。","exampleMeaning":"Cùng học từ “乞讨”: ăn mày."},{"id":"w02","term":"剧团","reading":"jùtuán","meaning":"đoàn kịch","example":"流动剧团","exampleMeaning":"Đoàn kịch lưu động"},{"id":"w03","term":"转折","reading":"zhuǎnzhé","meaning":"chuyển ngoặt","example":"我们来学“转折”这个词。","exampleMeaning":"Cùng học từ “转折”: chuyển ngoặt."},{"id":"w04","term":"新颖","reading":"xīnyǐng","meaning":"mới lạ","example":"题材新颖。","exampleMeaning":"Đề tài mới lạ"},{"id":"w05","term":"跨国","reading":"kuàguó","meaning":"đa quốc gia","example":"我们来学“跨国”这个词。","exampleMeaning":"Cùng học từ “跨国”: đa quốc gia."},{"id":"w06","term":"山路","reading":"shānlù","meaning":"đường núi","example":"山路弯弯","exampleMeaning":"Đường núi quanh co"},{"id":"w07","term":"传承","reading":"chuánchéng","meaning":"một truyền thống tiếp tục","example":"我们来学“传承”这个词。","exampleMeaning":"Cùng học từ “传承”: một truyền thống tiếp tục."},{"id":"w08","term":"劳累","reading":"láolèi","meaning":"phiền","example":"劳累你去一趟。","exampleMeaning":"Phiền anh đi giúp cho."},{"id":"w09","term":"刑法","reading":"xíngfǎ","meaning":"luật hình","example":"我们来学“刑法”这个词。","exampleMeaning":"Cùng học từ “刑法”: luật hình."},{"id":"w10","term":"口子","reading":"kǒuzi","meaning":"cửa","emoji":"🕳","example":"山谷的口子上有一 座选矿厂。","exampleMeaning":"Ở cửa thung lũng có một nhà máy tuyển quặng."},{"id":"w11","term":"体质","reading":"tǐzhì","meaning":"thể chất","example":"发展体育运动，增强人民体质。","exampleMeaning":"Phát triển phong trào thể dục, tăng cường sức khoẻ của nhân dân."},{"id":"w12","term":"阻拦","reading":"zǔlán","meaning":"ngăn cản","example":"他要去，谁也阻拦不住。","exampleMeaning":"Anh ấy muốn đi, không ai ngăn nổi anh ấy."},{"id":"w13","term":"取笑","reading":"qǔxiào","meaning":"pha trò","example":"我们来学“取笑”这个词。","exampleMeaning":"Cùng học từ “取笑”: pha trò."},{"id":"w14","term":"子弟","reading":"zǐdì","meaning":"con em","emoji":"🧒","example":"职工子弟","exampleMeaning":"Con em công nhân viên chức"},{"id":"w15","term":"丰富多彩","reading":"fēngfùduōcǎi","meaning":"muôn màu muôn vẻ","example":"我们来学“丰富多彩”这个词。","exampleMeaning":"Cùng học từ “丰富多彩”: muôn màu muôn vẻ."},{"id":"w16","term":"动荡","reading":"dòngdàng","meaning":"rối ren","example":"春秋时代是一个大动荡的时代。","exampleMeaning":"Thời Xuân Thu là một thời kỳ hết sức hỗn loạn"},{"id":"w17","term":"嗜好","reading":"shìhào","meaning":"ham mê","example":"我们来学“嗜好”这个词。","exampleMeaning":"Cùng học từ “嗜好”: ham mê."},{"id":"w18","term":"沿途","reading":"yántú","meaning":"ven đường","example":"我们来学“沿途”这个词。","exampleMeaning":"Cùng học từ “沿途”: ven đường."},{"id":"w19","term":"腥","reading":"xīng","meaning":"cá","example":"荤腥。","exampleMeaning":"Món ăn thịt cá"},{"id":"w20","term":"重播","reading":"chóngbō","meaning":"phát lại","example":"我们来学“重播”这个词。","exampleMeaning":"Cùng học từ “重播”: phát lại."}],"sentences":[{"id":"s1","tokens":["我","很","谦虚"],"reading":"wǒ hěn qiānxū","meaning":"Tôi rất khiêm tốn."},{"id":"s2","tokens":["你","很","害羞"],"reading":"nǐ hěn hàixiū","meaning":"Bạn rất nhút nhát."},{"id":"s3","tokens":["竞赛","是","爱国"],"reading":"jìngsài shì àiguó","meaning":"Thi đua là yêu nước."},{"id":"s4","tokens":["可惜","这","是","真","的"],"reading":"kěxī zhè shì zhēn de","meaning":"Tiếc rằng cái đó là sự thật."},{"id":"s5","tokens":["哦","有","一","只","蝴蝶"],"reading":"ó yǒu yī zhī húdié","meaning":"Ô kìa, con bươm bướm!"}]}
