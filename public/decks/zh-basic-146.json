{"id":"zh-basic-146","lang":"zh","course":"zh-basic","lesson":146,"draft":true,"level":"HSK1–HSK4","title":"Cơ bản · Bài 146","description":"尾巴 · 智能 · 手工 · 来得及 …","words":[{"id":"w01","term":"尾巴","reading":"wěiba","meaning":"đuôi","example":"飞机尾巴","exampleMeaning":"Đuôi máy bay"},{"id":"w02","term":"智能","reading":"zhìnéng","meaning":"trí tuệ và năng lực","example":"发展学生智能。","exampleMeaning":"Phát triển trí tuệ và năng lực của học sinh."},{"id":"w03","term":"手工","reading":"shǒugōng","meaning":"thủ công","example":"这件衣服多少手工？","exampleMeaning":"Cái áo này tiền công bao nhiêu?"},{"id":"w04","term":"来得及","reading":"láidejí","meaning":"kịp","example":"电影是七点开演，现在刚六点半，你马上去还来得及。","exampleMeaning":"Bây giờ mới có sáu giờ rưỡi, bảy giờ mới bắt đầu chiếu phim, anh đi ngay vẫn còn kịp."},{"id":"w05","term":"登录","reading":"dēnglù","meaning":"đăng ký","example":"登录在案","exampleMeaning":"Có trong hồ sơ đăng ký"},{"id":"w06","term":"穷人","reading":"qióngrén","meaning":"người nghèo","example":"我们来学“穷人”这个词。","exampleMeaning":"Cùng học từ “穷人”: người nghèo."},{"id":"w07","term":"符号","reading":"fúhào","meaning":"ký hiệu","example":"文字是记录语言的符号","exampleMeaning":"Chữ viết là ký hiệu dùng để ghi lại ngôn ngữ."},{"id":"w08","term":"节省","reading":"jiéshěng","meaning":"tiết kiệm","example":"节省每一个铜板用到革命事业上。","exampleMeaning":"Mỗi đồng tiền dành dụm được dùng cho sự nghiệp cách mạng."},{"id":"w09","term":"研究生","reading":"yánjiūshēng","meaning":"nghiên cứu sinh","example":"现在给大家吃个定心丸，今年的研究生分配方案已经基本落实了。","exampleMeaning":"Bây giờ xin trấn an mọi người, phương án phân bổ nghiên cứu sinh đã cơ bản hoàn thành."},{"id":"w10","term":"围巾","reading":"wéijīn","meaning":"khăn quàng cổ","emoji":"🧣","example":"我们来学“围巾”这个词。","exampleMeaning":"Cùng học từ “围巾”: khăn quàng cổ."},{"id":"w11","term":"宁静","reading":"níngjìng","meaning":"ninh Tịnh","example":"我们来学“宁静”这个词。","exampleMeaning":"Cùng học từ “宁静”: ninh Tịnh."},{"id":"w12","term":"树林","reading":"shùlín","meaning":"rừng cây","example":"我们来学“树林”这个词。","exampleMeaning":"Cùng học từ “树林”: rừng cây."},{"id":"w13","term":"以内","reading":"yǐnèi","meaning":"trong vòng","example":"五十人以内","exampleMeaning":"Trong vòng 50 người."},{"id":"w14","term":"多种","reading":"duōzhǒng","meaning":"phong phú","example":"我们来学“多种”这个词。","exampleMeaning":"Cùng học từ “多种”: phong phú."},{"id":"w15","term":"型号","reading":"xínghào","meaning":"loại","example":"我们来学“型号”这个词。","exampleMeaning":"Cùng học từ “型号”: loại."},{"id":"w16","term":"快递","reading":"kuàidì","meaning":"chuyển phát nhanh","example":"我们来学“快递”这个词。","exampleMeaning":"Cùng học từ “快递”: chuyển phát nhanh."},{"id":"w17","term":"新型","reading":"xīnxíng","meaning":"kiểu mới","example":"我们来学“新型”这个词。","exampleMeaning":"Cùng học từ “新型”: kiểu mới."},{"id":"w18","term":"酸奶","reading":"suānnǎi","meaning":"sữa chua","example":"我们来学“酸奶”这个词。","exampleMeaning":"Cùng học từ “酸奶”: sữa chua."},{"id":"w19","term":"优美","reading":"yōuměi","meaning":"tốt đẹp","example":"优美的民间艺术。","exampleMeaning":"Nghệ thuật dân gian hay."},{"id":"w20","term":"耳机","reading":"ěrjī","meaning":"ống nghe điện thoại","example":"我们来学“耳机”这个词。","exampleMeaning":"Cùng học từ “耳机”: ống nghe điện thoại."}],"sentences":[{"id":"s1","tokens":["我","只","知道","这些"],"reading":"wǒ zhǐ zhīdào zhèxiē","meaning":"Tôi chỉ biết thế thôi."},{"id":"s2","tokens":["这","张","桌子","不","好"],"reading":"zhè zhāng zhuōzi bù hǎo","meaning":"Cái bàn này không tốt."},{"id":"s3","tokens":["你","家里","都","有","谁"],"reading":"nǐ jiālǐ dōu yǒu shéi","meaning":"Nhà anh có những ai?"},{"id":"s4","tokens":["送","你","一点","礼物"],"reading":"sòng nǐ yīdiǎn lǐwù","meaning":"Biếu chị một chút quà."},{"id":"s5","tokens":["明天","我们","还","来"],"reading":"míngtiān wǒmen hái lái","meaning":"Ngày mai, chúng tôi còn đến đây."}]}
