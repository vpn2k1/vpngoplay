{"id":"zh-advanced-064","lang":"zh","course":"zh-advanced","lesson":64,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 64","description":"亲生 · 胡说 · 根源 · 席位 …","words":[{"id":"w01","term":"亲生","reading":"qīnshēng","meaning":"con đẻ","example":"小明是她亲生的。","exampleMeaning":"Bé Minh là con đẻ của cô ấy."},{"id":"w02","term":"胡说","reading":"húshuō","meaning":"nói xằng","example":"这纯属胡说，不必理会。","exampleMeaning":"Nói xằng bậy quá, không nên để ý."},{"id":"w03","term":"根源","reading":"gēnyuán","meaning":"bắt nguồn","example":"经济危机根源于资本主义制度。","exampleMeaning":"Khủng hoảng kinh tế bắt nguồn từ chế độ tư bản chủ nghĩa."},{"id":"w04","term":"席位","reading":"xíwèi","meaning":"ghế","example":"我们来学“席位”这个词。","exampleMeaning":"Cùng học từ “席位”: ghế."},{"id":"w05","term":"妄想","reading":"wàngxiǎng","meaning":"tính toán ngông cuồng","example":"敌人妄想卷土重来。","exampleMeaning":"Kẻ địch điên cuồng quay trở lại"},{"id":"w06","term":"榨","reading":"zhà","meaning":"ép, nép, bóp","example":"榨甘蔗","exampleMeaning":"Ép mía"},{"id":"w07","term":"匆忙","reading":"cōngmáng","meaning":"vội vội vàng vàng","example":"临行匆忙，没能来看你。","exampleMeaning":"Lúc đi vội vội vàng vàng nên không ghé thăm anh được."},{"id":"w08","term":"玩耍","reading":"wánshuǎ","meaning":"chơi đùa","example":"孩子们在大树底下玩耍。","exampleMeaning":"Bọn trẻ con đang chői đuĚa dýőěi boěng cây to."},{"id":"w09","term":"笼罩","reading":"lǒngzhào","meaning":"bao, bọc, phủ","example":"朦胧的月光笼罩着原野。","exampleMeaning":"Ánh trăng phủ khắp cánh đồng."},{"id":"w10","term":"卓越","reading":"zhuóyuè","meaning":"lỗi lạc","example":"卓越的科学家","exampleMeaning":"Nhà khoa học lỗi lạc"},{"id":"w11","term":"全局","reading":"quánjú","meaning":"toàn cuộc","example":"胸怀全局。","exampleMeaning":"Suy nghĩ cho toàn cuộc."},{"id":"w12","term":"减速","reading":"jiǎnsù","meaning":"giảm tốc độ","example":"我们来学“减速”这个词。","exampleMeaning":"Cùng học từ “减速”: giảm tốc độ."},{"id":"w13","term":"响应","reading":"xiǎngyìng","meaning":"hưởng ứng","example":"我们来学“响应”这个词。","exampleMeaning":"Cùng học từ “响应”: hưởng ứng."},{"id":"w14","term":"瀑布","reading":"pùbù","meaning":"thác nước","example":"我们来学“瀑布”这个词。","exampleMeaning":"Cùng học từ “瀑布”: thác nước."},{"id":"w15","term":"失恋","reading":"shīliàn","meaning":"thất tình","example":"我们来学“失恋”这个词。","exampleMeaning":"Cùng học từ “失恋”: thất tình."},{"id":"w16","term":"顾虑","reading":"gùlǜ","meaning":"lo lắng","example":"你不必有任何顾虑。","exampleMeaning":"Anh không cần lo lắng gì."},{"id":"w17","term":"监护","reading":"jiānhù","meaning":"giám sát","example":"大哥常常暗里监护着她，他不让她走到外边去。","exampleMeaning":"Anh cả thường bí mật giám sát chị dâu, vì anh ấy không muốn chị dâu đi ra ngoài."},{"id":"w18","term":"鳄鱼","reading":"èyú","meaning":"cá sấu","example":"我们来学“鳄鱼”这个词。","exampleMeaning":"Cùng học từ “鳄鱼”: cá sấu."},{"id":"w19","term":"恐吓","reading":"kǒnghè","meaning":"đe doạ","example":"恐吓信。","exampleMeaning":"Thư đe doạ."},{"id":"w20","term":"混凝土","reading":"hùnníngtǔ","meaning":"bê tông","example":"钢筋混凝土","exampleMeaning":"Bê tông cốt sắt"}],"sentences":[{"id":"s1","tokens":["有人","正在","弹","钢琴"],"reading":"yǒurén zhèngzài tán gāngqín","meaning":"Có người nào đó đang chơi đàn piano."},{"id":"s2","tokens":["上帝","创造","了","天地"],"reading":"shàngdì chuàngzào le tiāndì","meaning":"Chúa đã tạo ra \"Trời\" và \"Đất\"."},{"id":"s3","tokens":["万","幸","没","乘客","受伤"],"reading":"wàn xìng méi chéngkè shòushāng","meaning":"Rất may, không có hành khách nào bị thương."},{"id":"s4","tokens":["你","真","的","拥抱","汤姆"],"reading":"nǐ zhēn de yōngbào tāngmǔ","meaning":"Cậu thật sự ôm Tom?"},{"id":"s5","tokens":["可能","你","应该","放弃"],"reading":"kěnéng nǐ yīnggāi fàngqì","meaning":"Có lẽ bạn nên bỏ cuộc."}]}
