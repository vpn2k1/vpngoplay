aning":"Anh ấy không cố ý làm việc đó."},{"id":"s3","tokens":["She","reconciled","with","her","friend"],"meaning":"Cô ấy đã hòa giải với người bạn của mình."},{"id":"s4","tokens":["Grace","wore","an","indignant","look"],"meaning":"Grace tỏ ra bất bình."},{"id":"s5","tokens":["This","book","deals","with","anthropology"],"meaning":"Cuốn sách này nói về chủ đề nhân loại học."}]}
