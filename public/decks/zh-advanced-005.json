{"id":"zh-advanced-005","lang":"zh","course":"zh-advanced","lesson":5,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 5","description":"是非 · 言论 · 辣椒 · 无敌 …","words":[{"id":"w01","term":"是非","reading":"shìfēi","meaning":"phải trái, thị phi","example":"明辨是非。","exampleMeaning":"Phân biệt đúng sai."},{"id":"w02","term":"言论","reading":"yánlùn","meaning":"ngôn luận, phát ngôn","example":"我们来学“言论”这个词。","exampleMeaning":"Cùng học từ “言论”: ngôn luận, phát ngôn."},{"id":"w03","term":"辣椒","reading":"làjiāo","meaning":"ớt","emoji":"🌶","example":"我们来学“辣椒”这个词。","exampleMeaning":"Cùng học từ “辣椒”: ớt."},{"id":"w04","term":"无敌","reading":"wúdí","meaning":"vô địch","example":"所向无敌。","exampleMeaning":"Đến đâu cũng không ai địch nổi."},{"id":"w05","term":"罕见","reading":"hǎnjiàn","meaning":"hiếm thấy, hiếm có","example":"罕见的现象。","exampleMeaning":"Hiện tượng hiếm thấy."},{"id":"w06","term":"昏迷","reading":"hūnmí","meaning":"hôn mê","example":"昏迷不醒","exampleMeaning":"Hôn mê bất tĩnh"},{"id":"w07","term":"运转","reading":"yùnzhuǎn","meaning":"vận hành, hoạt động, xoay quanh","example":"发电机运转正常。","exampleMeaning":"Máy phát điện chạy bình thường"},{"id":"w08","term":"辉煌","reading":"huīhuáng","meaning":"huy hoàng, rực rỡ","example":"辉煌的成绩","exampleMeaning":"Thành tích huy hoàng"},{"id":"w09","term":"嫩","reading":"nèn","meaning":"non, mềm, non nớt","example":"小姑娘脸皮嫩，不肯表演。","exampleMeaning":"Mặt mày cô gái trông non nớt, không thể biểu diễn được."},{"id":"w10","term":"流浪","reading":"liúlàng","meaning":"lang thang, lưu lạc","example":"流浪街头。","exampleMeaning":"Lang thang đầu đường xó chợ."},{"id":"w11","term":"沙滩","reading":"shātān","meaning":"bãi cát","example":"我们来学“沙滩”这个词。","exampleMeaning":"Cùng học từ “沙滩”: bãi cát."},{"id":"w12","term":"手枪","reading":"shǒuqiāng","meaning":"súng lục","example":"我们来学“手枪”这个词。","exampleMeaning":"Cùng học từ “手枪”: súng lục."},{"id":"w13","term":"感恩","reading":"gǎnēn","meaning":"biết ơn","example":"感恩不尽","exampleMeaning":"Cảm ơn không hết"},{"id":"w14","term":"良心","reading":"liángxīn","meaning":"lương tâm","example":"说良心话。","exampleMeaning":"Thực lòng mà nói."},{"id":"w15","term":"火炬","reading":"huǒjù","meaning":"ngọn đuốc","example":"火炬接力赛。","exampleMeaning":"Cuộc thi chạy tiếp đuốc"},{"id":"w16","term":"友情","reading":"yǒuqíng","meaning":"tình bạn","example":"深厚的友情","exampleMeaning":"Tình bạn sâu sắc"},{"id":"w17","term":"出卖","reading":"chūmài","meaning":"bán đứng, phản bội, bán","example":"出卖民族利益的反动派永远被人民所唾弃。","exampleMeaning":"Bọn phản động bán rẻ lợi ích của dân tộc, suốt đời bị nhân dân khinh bỉ."},{"id":"w18","term":"发布会","reading":"fābùhuì","meaning":"buổi họp báo","example":"我们来学“发布会”这个词。","exampleMeaning":"Cùng học từ “发布会”: buổi họp báo."},{"id":"w19","term":"梦幻","reading":"mènghuàn","meaning":"mộng ảo, huyền ảo","example":"离奇的遭遇犹如梦幻。","exampleMeaning":"Cuộc gặp gỡ ly kỳ như trong mộng ảo."},{"id":"w20","term":"鲜血","reading":"xiānxuè","meaning":"máu tươi","example":"我们来学“鲜血”这个词。","exampleMeaning":"Cùng học từ “鲜血”: máu tươi."}],"sentences":[{"id":"s1","tokens":["我","的","表","被","偷","了"],"reading":"wǒ de biǎo bèi tōu le","meaning":"Đồng hồ của tôi bị trộm mất rồi."},{"id":"s2","tokens":["他","怎么","敢","抱怨"],"reading":"tā zěnme gǎn bàoyuàn","meaning":"Sao anh ta lại dám phàn nàn cơ chứ?"},{"id":"s3","tokens":["他们","彼此","相爱"],"reading":"tāmen bǐcǐ xiāngài","meaning":"Hai người họ yêu nhau."},{"id":"s4","tokens":["不","要","虐待","动物"],"reading":"bù yào nüèdài dòngwù","meaning":"Đừng ngược đãi động vật."},{"id":"s5","tokens":["我","要","把","他","射","下来"],"reading":"wǒ yào bǎ tā shè xiàlai","meaning":"Tao sẽ bắn hạ nó."}]}
