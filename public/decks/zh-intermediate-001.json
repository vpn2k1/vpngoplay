{"id":"zh-intermediate-001","lang":"zh","course":"zh-intermediate","lesson":1,"draft":true,"level":"HSK4–HSK7-9","title":"Trung cấp · Bài 1","description":"描写 · 相片 · 闹钟 · 大姐 …","words":[{"id":"w01","term":"描写","reading":"miáoxiě","meaning":"miêu tả","example":"描写人物的内心活动。","exampleMeaning":"Miêu tả diễn biến tâm trạng của nhân vật."},{"id":"w02","term":"相片","reading":"xiàngpiàn","meaning":"ảnh chụp (người)","example":"我们来学“相片”这个词。","exampleMeaning":"Cùng học từ “相片”: ảnh chụp (người)."},{"id":"w03","term":"闹钟","reading":"nàozhōng","meaning":"đồng hồ báo thức","emoji":"⏰","example":"我们来学“闹钟”这个词。","exampleMeaning":"Cùng học từ “闹钟”: đồng hồ báo thức."},{"id":"w04","term":"大姐","reading":"dàjiě","meaning":"chị cả","example":"我们来学“大姐”这个词。","exampleMeaning":"Cùng học từ “大姐”: chị cả."},{"id":"w05","term":"缩短","reading":"suōduǎn","meaning":"rút ngắn","example":"缩短战线。","exampleMeaning":"Rút ngắn trận tuyến."},{"id":"w06","term":"气球","reading":"qìqiú","meaning":"bóng hơi","emoji":"🎈","example":"我们来学“气球”这个词。","exampleMeaning":"Cùng học từ “气球”: bóng hơi."},{"id":"w07","term":"春季","reading":"chūnjì","meaning":"mùa xuân","example":"我们来学“春季”这个词。","exampleMeaning":"Cùng học từ “春季”: mùa xuân."},{"id":"w08","term":"长途","reading":"chángtú","meaning":"đường dài","example":"我要往加拿大打一个长途电话。","exampleMeaning":"Tôi muốn gọi điện thoại đường dài đi Ca-na-đa."},{"id":"w09","term":"赞赏","reading":"zànshǎng","meaning":"tán thưởng","example":"击节赞赏","exampleMeaning":"Gõ nhịp tán thưởng"},{"id":"w10","term":"议论","reading":"yìlùn","meaning":"bàn bạc","example":"大家都在议论这件事。","exampleMeaning":"Mọi người đang bàn bạc vấn đề này"},{"id":"w11","term":"熟练","reading":"shúliàn","meaning":"thạo","example":"我们来学“熟练”这个词。","exampleMeaning":"Cùng học từ “熟练”: thạo."},{"id":"w12","term":"及格","reading":"jígé","meaning":"đạt yêu cầu","example":"考试不及格","exampleMeaning":"Thi rớt; thi trượt; thi không đạt yêu cầu"},{"id":"w13","term":"讲究","reading":"jiǎngjiu","meaning":"chú ý","example":"我们一向讲究实事求是。","exampleMeaning":"Chúng tôi luôn coi trọng sự cầu thị."},{"id":"w14","term":"构造","reading":"gòuzào","meaning":"cấu tạo","example":"地层的构造","exampleMeaning":"Cấu tạo địa tầng; cấu tạo lớp đất."},{"id":"w15","term":"虫子","reading":"chóngzi","meaning":"sâu","example":"我们来学“虫子”这个词。","exampleMeaning":"Cùng học từ “虫子”: sâu."},{"id":"w16","term":"发票","reading":"fāpiào","meaning":"hoá đơn","example":"我们来学“发票”这个词。","exampleMeaning":"Cùng học từ “发票”: hoá đơn."},{"id":"w17","term":"词汇","reading":"cíhuì","meaning":"từ ngữ","example":"我们来学“词汇”这个词。","exampleMeaning":"Cùng học từ “词汇”: từ ngữ."},{"id":"w18","term":"不要紧","reading":"bùyàojǐn","meaning":"không sao","example":"这病不要紧，吃点儿药就好。","exampleMeaning":"Bịnh này không sao đâu, uống chút thuốc là khỏi ngay"},{"id":"w19","term":"刷牙","reading":"shuāyá","meaning":"đánh răng","example":"我们来学“刷牙”这个词。","exampleMeaning":"Cùng học từ “刷牙”: đánh răng."},{"id":"w20","term":"一再","reading":"yīzài","meaning":"nhiều lần","example":"一再声明","exampleMeaning":"Tuyên bố nhiều lần"}],"sentences":[{"id":"s1","tokens":["别","逼","我"],"reading":"bié bī wǒ","meaning":"Đừng ép tôi!"},{"id":"s2","tokens":["他","疯","了"],"reading":"tā fēng le","meaning":"Anh ta điên rồi."},{"id":"s3","tokens":["不","要","担心"],"reading":"bù yào dānxīn","meaning":"Đừng lo."},{"id":"s4","tokens":["我","好","胖","哦"],"reading":"wǒ hǎo pàng ó","meaning":"Tôi mập quá."},{"id":"s5","tokens":["好","疼","停下"],"reading":"hǎo téng tíngxià","meaning":"Đau quá! Dừng lại!"}]}
