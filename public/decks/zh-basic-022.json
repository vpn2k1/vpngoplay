{"id":"zh-basic-022","lang":"zh","course":"zh-basic","lesson":22,"draft":true,"level":"HSK1–HSK4","title":"Cơ bản · Bài 22","description":"生病 · 好听 · 开会 · 钱包 …","words":[{"id":"w01","term":"生病","reading":"shēngbìng","meaning":"sinh bệnh","example":"我们来学“生病”这个词。","exampleMeaning":"Cùng học từ “生病”: sinh bệnh."},{"id":"w02","term":"好听","reading":"hǎotīng","meaning":"bùi tai","example":"话说得好听，但还要看行动。","exampleMeaning":"Nói chuyện bùi tai, nhưng phải xem hành động đã."},{"id":"w03","term":"开会","reading":"kāihuì","meaning":"họp","example":"我们来学“开会”这个词。","exampleMeaning":"Cùng học từ “开会”: họp."},{"id":"w04","term":"钱包","reading":"qiánbāo","meaning":"ví tiền","emoji":"👛","example":"我们来学“钱包”这个词。","exampleMeaning":"Cùng học từ “钱包”: ví tiền."},{"id":"w05","term":"大学生","reading":"dàxuéshēng","meaning":"sinh viên","example":"我们来学“大学生”这个词。","exampleMeaning":"Cùng học từ “大学生”: sinh viên."},{"id":"w06","term":"车站","reading":"chēzhàn","meaning":"ga","example":"我们来学“车站”这个词。","exampleMeaning":"Cùng học từ “车站”: ga."},{"id":"w07","term":"走路","reading":"zǒulù","meaning":"đi","example":"不好好儿干，让他卷铺盖走路。","exampleMeaning":"Làm không tốt, để cho nó cuốn gói cút đi."},{"id":"w08","term":"小朋友","reading":"xiǎopéngyǒu","meaning":"trẻ em","emoji":"🧒","example":"我们来学“小朋友”这个词。","exampleMeaning":"Cùng học từ “小朋友”: trẻ em."},{"id":"w09","term":"左边","reading":"zuǒbian","meaning":"bên trái","example":"我们来学“左边”这个词。","exampleMeaning":"Cùng học từ “左边”: bên trái."},{"id":"w10","term":"有用","reading":"yǒuyòng","meaning":"có ích","example":"食物对动物有用，湿润对植物有用。","exampleMeaning":"Thức ăn có ích với động vật, sự ẩm ướt có lợi cho thực vật."},{"id":"w11","term":"爱好","reading":"àihào","meaning":"thích","example":"你的爱好是什么？","exampleMeaning":"Sở thích của bạn là gì?"},{"id":"w12","term":"不大","reading":"bùdà","meaning":"ít khi","example":"他最近不大来","exampleMeaning":"Anh ấy gần đây ít khi lui tới"},{"id":"w13","term":"午饭","reading":"wǔfàn","meaning":"bữa trưa","example":"我们来学“午饭”这个词。","exampleMeaning":"Cùng học từ “午饭”: bữa trưa."},{"id":"w14","term":"上车","reading":"shàngchē","meaning":"lên xe","example":"我们来学“上车”这个词。","exampleMeaning":"Cùng học từ “上车”: lên xe."},{"id":"w15","term":"马路","reading":"mǎlù","meaning":"đường cái","example":"我们来学“马路”这个词。","exampleMeaning":"Cùng học từ “马路”: đường cái."},{"id":"w16","term":"门票","reading":"ménpiào","meaning":"vé vào cửa","example":"我们来学“门票”这个词。","exampleMeaning":"Cùng học từ “门票”: vé vào cửa."},{"id":"w17","term":"机票","reading":"jīpiào","meaning":"vé máy bay","example":"我们来学“机票”这个词。","exampleMeaning":"Cùng học từ “机票”: vé máy bay."},{"id":"w18","term":"楼上","reading":"lóushàng","meaning":"tầng trên","example":"我们来学“楼上”这个词。","exampleMeaning":"Cùng học từ “楼上”: tầng trên."},{"id":"w19","term":"打球","reading":"dǎqiú","meaning":"chơi bóng","example":"我们来学“打球”这个词。","exampleMeaning":"Cùng học từ “打球”: chơi bóng."},{"id":"w20","term":"下雨","reading":"xiàyǔ","meaning":"mưa","example":"我们来学“下雨”这个词。","exampleMeaning":"Cùng học từ “下雨”: mưa."}],"sentences":[{"id":"s1","tokens":["我","爱好","翻译"],"reading":"wǒ àihào fānyì","meaning":"Mình rất thích dịch thuật."},{"id":"s2","tokens":["那是","我","的","爱好"],"reading":"nàshi wǒ de àihào","meaning":"Đó là sở thích của tui."},{"id":"s3","tokens":["你","的","爱好","是","什么"],"reading":"nǐ de àihào shì shénme","meaning":"Sở thích của bạn là gì?"},{"id":"s4","tokens":["我","爱","你"],"reading":"wǒ ài nǐ","meaning":"Anh phải lòng em."},{"id":"s5","tokens":["我","到","了"],"reading":"wǒ dào le","meaning":"Tôi đến."}]}
