{"id":"zh-advanced-114","lang":"zh","course":"zh-advanced","lesson":114,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 114","description":"混淆 · 盛会 · 投稿 · 动听 …","words":[{"id":"w01","term":"混淆","reading":"hùnxiáo","meaning":"lẫn lộn, nhầm lẫn","example":"真伪混淆","exampleMeaning":"Thực giả lẫn lộn"},{"id":"w02","term":"盛会","reading":"shènghuì","meaning":"đại hội, sự kiện lớn","example":"团结的盛会。","exampleMeaning":"Cuộc họp đoàn kết."},{"id":"w03","term":"投稿","reading":"tóugǎo","meaning":"gửi bài, gửi bản thảo","example":"欢迎投稿","exampleMeaning":"Hoan nghênh gửi bài văn."},{"id":"w04","term":"动听","reading":"dòngtīng","meaning":"êm tai, du dương","example":"极平常的事儿，让他说起来就很动听。","exampleMeaning":"Câu chuyện rất tầm thường, nhưng anh ấy nói nghe rất thú vị."},{"id":"w05","term":"惊险","reading":"jīngxiǎn","meaning":"gay cấn, hiểm nghèo","example":"一本写得最惊险的故事书在我这儿，我还没有看完","exampleMeaning":"Quyển sách viết những chuyện giật gân nhất đang ở bên tôi đây, tôi vẫn chưa đọc xong"},{"id":"w06","term":"急剧","reading":"jíjù","meaning":"đột ngột, nhanh chóng","example":"城市人口急剧增长。","exampleMeaning":"Dân số thành phố tăng nhanh"},{"id":"w07","term":"迎合","reading":"yínghé","meaning":"chiều theo, đón ý","example":"迎合上司","exampleMeaning":"Nói hùa theo cấp trên"},{"id":"w08","term":"厌烦","reading":"yànfán","meaning":"chán ngấy, phát chán","example":"我们来学“厌烦”这个词。","exampleMeaning":"Cùng học từ “厌烦”: chán ngấy, phát chán."},{"id":"w09","term":"交涉","reading":"jiāoshè","meaning":"giao thiệp, đàm phán","example":"你去交涉一下，看能不能提前交货。","exampleMeaning":"Anh đi thương lượng chút đi, xem có thể giao hàng sớm được không?"},{"id":"w10","term":"均衡","reading":"jūnhéng","meaning":"cân bằng, cân đối","example":"国民经济均衡地发展。","exampleMeaning":"Kinh tế quốc dân phát triển một cách cân đối."},{"id":"w11","term":"教科书","reading":"jiàokēshū","meaning":"sách giáo khoa","example":"我们来学“教科书”这个词。","exampleMeaning":"Cùng học từ “教科书”: sách giáo khoa."},{"id":"w12","term":"本意","reading":"běnyì","meaning":"ý định ban đầu, bản ý","example":"我们来学“本意”这个词。","exampleMeaning":"Cùng học từ “本意”: ý định ban đầu, bản ý."},{"id":"w13","term":"思索","reading":"sīsuǒ","meaning":"ngẫm nghĩ, suy tư","example":"思索问题。","exampleMeaning":"Suy nghĩ vấn đề."},{"id":"w14","term":"二氧化碳","reading":"èryǎnghuàtàn","meaning":"khí cacbonic, CO2","example":"我们来学“二氧化碳”这个词。","exampleMeaning":"Cùng học từ “二氧化碳”: khí cacbonic, CO2."},{"id":"w15","term":"夸大","reading":"kuādà","meaning":"phóng đại, thổi phồng","example":"夸大成绩。","exampleMeaning":"Thổi phồng thành tích."},{"id":"w16","term":"改良","reading":"gǎiliáng","meaning":"cải tiến, cải thiện","example":"改良土壤","exampleMeaning":"Cải tiến đất đai."},{"id":"w17","term":"渔船","reading":"yúchuán","meaning":"thuyền đánh cá, tàu cá","example":"我们来学“渔船”这个词。","exampleMeaning":"Cùng học từ “渔船”: thuyền đánh cá, tàu cá."},{"id":"w18","term":"盟友","reading":"méngyǒu","meaning":"đồng minh","example":"我们来学“盟友”这个词。","exampleMeaning":"Cùng học từ “盟友”: đồng minh."},{"id":"w19","term":"正视","reading":"zhèngshì","meaning":"nhìn thẳng vào, đối mặt","example":"正视自己的缺点","exampleMeaning":"Nghiêm chỉnh với khuyết điểm bản thân."},{"id":"w20","term":"投身","reading":"tóushēn","meaning":"dấn thân, lao vào","example":"投身于教育事业。","exampleMeaning":"Lao vào sự nghiệp giáo dục."}],"sentences":[{"id":"s1","tokens":["此处","禁止","停车"],"reading":"cǐchù jìnzhǐ tíngchē","meaning":"Cấm đậu xe nơi đây."},{"id":"s2","tokens":["他","吃","了","毒","蘑菇"],"reading":"tā chī le dú mógu","meaning":"Nó ăn phải nấm độc."},{"id":"s3","tokens":["五","乘","二等","于","十"],"reading":"wǔ chéng èrděng yú shí","meaning":"Năm nhân hai bằng mười."},{"id":"s4","tokens":["时间","就是","金钱"],"reading":"shíjiān jiùshì jīnqián","meaning":"Thời gian là vàng."},{"id":"s5","tokens":["你","有","什么","症状"],"reading":"nǐ yǒu shénme zhèngzhuàng","meaning":"Bạn có triệu chứng gì?"}]}
