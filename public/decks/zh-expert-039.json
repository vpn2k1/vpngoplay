{"id":"zh-expert-039","lang":"zh","course":"zh-expert","lesson":39,"draft":true,"level":"HSK7-9–HSK+","title":"Chuyên sâu · Bài 39","description":"军阀 · 见效 · 历代 · 水利 …","words":[{"id":"w01","term":"军阀","reading":"jūnfá","meaning":"quân phiệt","example":"军阀主义","exampleMeaning":"Chủ nghĩa quân phiệt"},{"id":"w02","term":"见效","reading":"jiànxiào","meaning":"có hiệu quả, công hiệu","example":"这药吃下去就见效。","exampleMeaning":"Loại thuốc này uống vào là có hiệu lực."},{"id":"w03","term":"历代","reading":"lìdài","meaning":"các đời, qua các triều đại","example":"这里的珍珠养殖业历代不衰。","exampleMeaning":"Nghề nuôi trai ở nơi này qua nhiều thời kỳ cũng không bị suy yếu."},{"id":"w04","term":"水利","reading":"shuǐlì","meaning":"thủy lợi","example":"我们来学“水利”这个词。","exampleMeaning":"Cùng học từ “水利”: thủy lợi."},{"id":"w05","term":"宝库","reading":"bǎokù","meaning":"kho báu, kho tàng","example":"知识宝库","exampleMeaning":"Kho tàng tri thức"},{"id":"w06","term":"志气","reading":"zhìqì","meaning":"chí khí","example":"人小志气大","exampleMeaning":"Người nhỏ nhưng chí lớn"},{"id":"w07","term":"拜年","reading":"bàinián","meaning":"chúc Tết","example":"给大家拜年","exampleMeaning":"Chúc tết mọi người"},{"id":"w08","term":"下功夫","reading":"xiàgōngfu","meaning":"bỏ công sức, dồn công","example":"我们来学“下功夫”这个词。","exampleMeaning":"Cùng học từ “下功夫”: bỏ công sức, dồn công."},{"id":"w09","term":"全文","reading":"quánwén","meaning":"toàn văn, toàn bộ văn bản","example":"我们来学“全文”这个词。","exampleMeaning":"Cùng học từ “全文”: toàn văn, toàn bộ văn bản."},{"id":"w10","term":"酒杯","reading":"jiǔbēi","meaning":"ly rượu, chén rượu","example":"我们来学“酒杯”这个词。","exampleMeaning":"Cùng học từ “酒杯”: ly rượu, chén rượu."},{"id":"w11","term":"同人","reading":"tóngrén","meaning":"đồng nghiệp, người cùng nghề","example":"我们来学“同人”这个词。","exampleMeaning":"Cùng học từ “同人”: đồng nghiệp, người cùng nghề."},{"id":"w12","term":"诞辰","reading":"dànchén","meaning":"ngày sinh (trang trọng)","example":"我们来学“诞辰”这个词。","exampleMeaning":"Cùng học từ “诞辰”: ngày sinh (trang trọng)."},{"id":"w13","term":"频频","reading":"pínpín","meaning":"liên tục, liên tiếp","example":"我们来学“频频”这个词。","exampleMeaning":"Cùng học từ “频频”: liên tục, liên tiếp."},{"id":"w14","term":"诀别","reading":"juébié","meaning":"vĩnh biệt, từ biệt","example":"我们来学“诀别”这个词。","exampleMeaning":"Cùng học từ “诀别”: vĩnh biệt, từ biệt."},{"id":"w15","term":"统领","reading":"tǒnglǐng","meaning":"thống lĩnh","example":"统领各路人马。","exampleMeaning":"Thống lĩnh binh ngựa các nơi."},{"id":"w16","term":"酒楼","reading":"jiǔlóu","meaning":"nhà hàng, tửu lầu","example":"我们来学“酒楼”这个词。","exampleMeaning":"Cùng học từ “酒楼”: nhà hàng, tửu lầu."},{"id":"w17","term":"同义词","reading":"tóngyìcí","meaning":"từ đồng nghĩa","example":"我们来学“同义词”这个词。","exampleMeaning":"Cùng học từ “同义词”: từ đồng nghĩa."},{"id":"w18","term":"汹涌","reading":"xiōngyǒng","meaning":"cuồn cuộn, dữ dội","example":"波涛汹涌。","exampleMeaning":"Sóng nước cuộn trào"},{"id":"w19","term":"通向","reading":"tōngxiàng","meaning":"dẫn tới, thông tới","example":"我们来学“通向”这个词。","exampleMeaning":"Cùng học từ “通向”: dẫn tới, thông tới."},{"id":"w20","term":"官军","reading":"guānjūn","meaning":"quân triều đình","example":"我们来学“官军”这个词。","exampleMeaning":"Cùng học từ “官军”: quân triều đình."}],"sentences":[{"id":"s1","tokens":["你","很","害羞"],"reading":"nǐ hěn hàixiū","meaning":"Bạn rất nhút nhát."},{"id":"s2","tokens":["哦","有","一","只","蝴蝶"],"reading":"ó yǒu yī zhī húdié","meaning":"Ô kìa, con bươm bướm!"},{"id":"s3","tokens":["他","吃","了","毒","蘑菇"],"reading":"tā chī le dú mógu","meaning":"Nó ăn phải nấm độc."},{"id":"s4","tokens":["不","要","虐待","动物"],"reading":"bù yào nüèdài dòngwù","meaning":"Đừng ngược đãi động vật."},{"id":"s5","tokens":["我","昨天","被","解雇","了"],"reading":"wǒ zuótiān bèi jiěgù le","meaning":"Tôi đã bị sa thải hồi hôm qua."}]}
