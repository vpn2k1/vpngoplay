{"id":"en-intermediate-057","lang":"en","course":"en-intermediate","lesson":57,"draft":true,"level":"B1–B2","title":"Trung cấp · Bài 57","description":"alphabet · steep · namely · swear …","words":[{"id":"w01","term":"alphabet","reading":"/ˈæl.fəˌbɛt/","meaning":"bảng chữ cái, hệ thống chữ cái","example":"The Czech alphabet consists of 42 letters.","exampleMeaning":"Bảng chữ cái tiếng Séc có 42 chữ cái."},{"id":"w02","term":"steep","reading":"/ˈstip/","meaning":"dốc","example":"We climbed up the steep mountain.","exampleMeaning":"Chúng tôi trèo lên ngọn nói dốc đứng."},{"id":"w03","term":"namely","reading":"/ˈneɪmli/","meaning":"là, ấy là","example":"Let's learn the word \"namely\".","exampleMeaning":"Cùng học từ “namely”: là, ấy là."},{"id":"w04","term":"swear","reading":"/ˈswɛr/","meaning":"thề, thề nguyền, tuyên thệ","example":"I swear it's not true.","exampleMeaning":"Tôi thề là không phải thế."},{"id":"w05","term":"handball","reading":"/ˈhændˌbɔl/","meaning":"môn bóng ném","example":"Let's learn the word \"handball\".","exampleMeaning":"Cùng học từ “handball”: môn bóng ném."},{"id":"w06","term":"working","reading":"/ˈwɜːkɪŋ/","meaning":"công, làm việc","example":"This is working great.","exampleMeaning":"Thứ này làm việc tốt quá."},{"id":"w07","term":"abstract","reading":"/ˈæbˌstrækt/","meaning":"trừu tượng","example":"to abstract butter from milk","exampleMeaning":"Tách bơ ra khỏi sữa"},{"id":"w08","term":"symptom","reading":"/ˈsɪmptəm/","meaning":"triệu chứng","example":"Let's learn the word \"symptom\".","exampleMeaning":"Cùng học từ “symptom”: triệu chứng."},{"id":"w09","term":"suspicion","reading":"/səˈspɪʃən/","meaning":"tí, chút","example":"his honesty is above suspicion","exampleMeaning":"Tính chân thật của anh ta thì không ai còn có thể nghi ngờ"},{"id":"w10","term":"aspirin","reading":"/ˈæsprɪn/","meaning":"atpirin","example":"Let's learn the word \"aspirin\".","exampleMeaning":"Cùng học từ “aspirin”: atpirin."},{"id":"w11","term":"curiously","reading":"/ˈkjʊriəsli/","meaning":"tò mò, hiếu kỳ","example":"Let's learn the word \"curiously\".","exampleMeaning":"Cùng học từ “curiously”: tò mò, hiếu kỳ."},{"id":"w12","term":"stimulus","reading":"/ˈstɪmjələs/","meaning":"kích thích","example":"under the stimulus of hunger","exampleMeaning":"Do tác dụng kích thích"},{"id":"w13","term":"liability","reading":"/ˌlaɪəˈbɪlɪti/","meaning":"nghĩa vụ","example":"liability for military service","exampleMeaning":"Nghĩa vụ tòng quân"},{"id":"w14","term":"novelist","reading":"/ˈnɑvələst/","meaning":"người viết tiểu thuyết","example":"He is a novelist and a painter.","exampleMeaning":"Anh ấy là một tiểu thuyết gia kiêm hoạ sĩ."},{"id":"w15","term":"sandal","reading":"/ˈsændəl/","meaning":"dép","example":"Let's learn the word \"sandal\".","exampleMeaning":"Cùng học từ “sandal”: dép."},{"id":"w16","term":"unfit","reading":"/ənˈfɪt/","meaning":"không dùng được","example":"to be unfit for a doctor","exampleMeaning":"Không đủ năng lực (tư cách) làm bác sĩ"},{"id":"w17","term":"tense","reading":"/ˈtɛns/","meaning":"căng","example":"the present tense","exampleMeaning":"Thời hiện tại"},{"id":"w18","term":"folk","reading":"/ˈfoʊk/","meaning":"người","example":"Tom is a folk singer.","exampleMeaning":"Tom là một ca sĩ dân ca."},{"id":"w19","term":"distribute","reading":"/dɪˈstrɪbjuːt/","meaning":"rắc, rải","example":"to distribute manure over a field","exampleMeaning":"Rắc phân lên khắp cánh đồng"},{"id":"w20","term":"oppression","reading":"/əˈprɛʃən/","meaning":"sự đàn áp, sự áp bức","example":"Let's learn the word \"oppression\".","exampleMeaning":"Cùng học từ “oppression”: sự đàn áp, sự áp bức."}],"sentences":[{"id":"s1","tokens":["Everything","is","working"],"meaning":"Tất cả đều đang hoạt động."},{"id":"s2","tokens":["I'm","hard","working"],"meaning":"Tôi là một người chăm chỉ."},{"id":"s3","tokens":["I","started","working"],"meaning":"Tôi bắt đầu công việc."},{"id":"s4","tokens":["Why","aren't","these","working"],"meaning":"Tại sao những cái này không hoạt động?"},{"id":"s5","tokens":["Why","aren't","you","working"],"meaning":"Sao cậu không làm việc?"}]}
