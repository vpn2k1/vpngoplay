{"id":"zh-advanced-059","lang":"zh","course":"zh-advanced","lesson":59,"draft":true,"level":"HSK7-9","title":"Nâng cao · Bài 59","description":"慷慨 · 烦躁 · 巨型 · 存放 …","words":[{"id":"w01","term":"慷慨","reading":"kāngkǎi","meaning":"hào phóng, khảng khái","example":"慷慨无私的援助。","exampleMeaning":"Sự viện trợ vô tư."},{"id":"w02","term":"烦躁","reading":"fánzào","meaning":"bực bội, bồn chồn","example":"烦躁不安","exampleMeaning":"Buồn bực không yên"},{"id":"w03","term":"巨型","reading":"jùxíng","meaning":"khổng lồ, cỡ lớn","example":"我们来学“巨型”这个词。","exampleMeaning":"Cùng học từ “巨型”: khổng lồ, cỡ lớn."},{"id":"w04","term":"存放","reading":"cúnfàng","meaning":"cất giữ, gửi","example":"把节余的钱存放在银行里。","exampleMeaning":"Đem tiền dư gửi vào ngân hàng."},{"id":"w05","term":"逢","reading":"féng","meaning":"gặp, gặp dịp","example":"每逢佳节倍思亲。","exampleMeaning":"Mỗi khi đến ngày tết vui vẻ thì càng nhớ đến người thân."},{"id":"w06","term":"好说","reading":"hǎoshuō","meaning":"dễ thôi, quá khen","example":"好说，好说！您太夸奖了。","exampleMeaning":"Không dám, không dám, bác quá khen!"},{"id":"w07","term":"对策","reading":"duìcè","meaning":"đối sách, biện pháp đối phó","example":"商量对策","exampleMeaning":"Thương lượng đối sách"},{"id":"w08","term":"扰乱","reading":"rǎoluàn","meaning":"quấy nhiễu, làm rối loạn","example":"扰乱治安。","exampleMeaning":"Làm hỗn loạn trật tự trị an."},{"id":"w09","term":"源于","reading":"yuányú","meaning":"bắt nguồn từ","example":"我们来学“源于”这个词。","exampleMeaning":"Cùng học từ “源于”: bắt nguồn từ."},{"id":"w10","term":"启示","reading":"qǐshì","meaning":"bài học, gợi mở","example":"我们来学“启示”这个词。","exampleMeaning":"Cùng học từ “启示”: bài học, gợi mở."},{"id":"w11","term":"社团","reading":"shètuán","meaning":"câu lạc bộ, hội nhóm, đoàn thể","example":"我们来学“社团”这个词。","exampleMeaning":"Cùng học từ “社团”: câu lạc bộ, hội nhóm, đoàn thể."},{"id":"w12","term":"渡过","reading":"dùguò","meaning":"vượt qua","example":"我们来学“渡过”这个词。","exampleMeaning":"Cùng học từ “渡过”: vượt qua."},{"id":"w13","term":"转悠","reading":"zhuànyou","meaning":"đi lòng vòng, dạo quanh","example":"星期天我上街转悠了一下。","exampleMeaning":"Chủ nhật tôi thường đi dạo."},{"id":"w14","term":"手头","reading":"shǒutóu","meaning":"trong tay, túi tiền","example":"这部书我倒有，可惜不在手头。","exampleMeaning":"Bộ sách này tôi có, thật tiếc bây giờ không giữ trong tay."},{"id":"w15","term":"测验","reading":"cèyàn","meaning":"kiểm tra, bài kiểm tra","example":"民意测验。","exampleMeaning":"Thăm dò dư luận quần chúng; thăm dò ý dân"},{"id":"w16","term":"溅","reading":"jiàn","meaning":"bắn tung tóe, văng","example":"溅了一身泥。","exampleMeaning":"Toé bùn."},{"id":"w17","term":"资深","reading":"zīshēn","meaning":"lâu năm, kỳ cựu","example":"资深望重","exampleMeaning":"Thâm niên vọng trọng"},{"id":"w18","term":"缓缓","reading":"huǎnhuǎn","meaning":"chầm chậm, từ từ","example":"我们来学“缓缓”这个词。","exampleMeaning":"Cùng học từ “缓缓”: chầm chậm, từ từ."},{"id":"w19","term":"确诊","reading":"quèzhěn","meaning":"chẩn đoán xác định","example":"我们来学“确诊”这个词。","exampleMeaning":"Cùng học từ “确诊”: chẩn đoán xác định."},{"id":"w20","term":"崇高","reading":"chónggāo","meaning":"cao cả, cao thượng","example":"崇高的敬礼。","exampleMeaning":"Lời chào cao cả."}],"sentences":[{"id":"s1","tokens":["此处","禁止","停车"],"reading":"cǐchù jìnzhǐ tíngchē","meaning":"Cấm đậu xe nơi đây."},{"id":"s2","tokens":["五","乘","二等","于","十"],"reading":"wǔ chéng èrděng yú shí","meaning":"Năm nhân hai bằng mười."},{"id":"s3","tokens":["时间","就是","金钱"],"reading":"shíjiān jiùshì jīnqián","meaning":"Thời gian là vàng."},{"id":"s4","tokens":["你","有","什么","症状"],"reading":"nǐ yǒu shénme zhèngzhuàng","meaning":"Bạn có triệu chứng gì?"},{"id":"s5","tokens":["我","睡","了","个","好","觉"],"reading":"wǒ shuì le gè hǎo jiào","meaning":"Tôi đã có một giấc ngủ ngon."}]}
