:["People","were","sympathetic","to","Fadil"],"meaning":"Mọi người đồng cảm với Fadil."},{"id":"s2","tokens":["She","shares","her","experiences","openly"],"meaning":"Cô ấy chia sẻ kinh nghiệm một cách cởi mở."},{"id":"s3","tokens":["I","wear","boxers"],"meaning":"Tôi mặc quần đùi"},{"id":"s4","tokens":["We","have","suppliers"],"meaning":"Chúng tôi có những nhà cung cấp."},{"id":"s5","tokens":["I","like","penguins"],"meaning":"Tôi thích chim cánh cụt."}]}
