":[{"id":"s1","tokens":["I'm","trying","to","save","more","money"],"meaning":"Tôi đang cố gắng tiết kiệm thêm tiền."},{"id":"s2","tokens":["Many","pupils","are","poor","at","algebra"],"meaning":"Nhiều học sinh học kém môn đại số."},{"id":"s3","tokens":["This","should","help","alleviate","the","pain"],"meaning":"Nó sẽ giúp làm dịu cơn đau."},{"id":"s4","tokens":["He","is","generally","an","impeccable","student"],"meaning":"Nhìn chung thì anh ấy là con ngoan trò giỏi."},{"id":"s5","tokens":["She","was","standing","on","one","foot"],"meaning":"Cô ấy đang đứng một chân."}]}
