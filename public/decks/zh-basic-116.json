{"id":"zh-basic-116","lang":"zh","course":"zh-basic","lesson":116,"draft":true,"level":"HSK1–HSK4","title":"Cơ bản · Bài 116","description":"帅 · 网络 · 烧 · 数据 …","words":[{"id":"w01","term":"帅","reading":"shuài","meaning":"soái","example":"你男朋友真帅！","exampleMeaning":"Bạn trai của bạn đẹp trai quá!"},{"id":"w02","term":"网络","reading":"wǎngluò","meaning":"mạch lưới","example":"我们来学“网络”这个词。","exampleMeaning":"Cùng học từ “网络”: mạch lưới."},{"id":"w03","term":"烧","reading":"shāo","meaning":"sốt","example":"他现在烧得厉害。","exampleMeaning":"Hiện giờ anh ấy sốt rất cao."},{"id":"w04","term":"数据","reading":"shùjù","meaning":"số liệu","example":"我们来学“数据”这个词。","exampleMeaning":"Cùng học từ “数据”: số liệu."},{"id":"w05","term":"申请","reading":"shēnqǐng","meaning":"xin","example":"申请入党。","exampleMeaning":"Xin vào đảng."},{"id":"w06","term":"安","reading":"ān","meaning":"sao","example":"周圍的地區非常安靜。","exampleMeaning":"Khu vực xung quanh đây rất yên tĩnh."},{"id":"w07","term":"圈","reading":"juān","meaning":"vòng","example":"桌子周围挤着一圈人。","exampleMeaning":"Mọi người vây tròn chung quanh bàn."},{"id":"w08","term":"稳定","reading":"wěndìng","meaning":"ổn định","example":"这几天九龙江水位很稳定。","exampleMeaning":"Mấy ngày nay mực nước sông Cửu Long rất ổn định."},{"id":"w09","term":"巨大","reading":"jùdà","meaning":"to lớn","example":"巨大的工程。","exampleMeaning":"Công trình vĩ đại."},{"id":"w10","term":"土地","reading":"tǔdì","meaning":"thổ địa","example":"土地堂(土地庙)。","exampleMeaning":"Miếu thổ địa."},{"id":"w11","term":"老婆","reading":"lǎopó","meaning":"vợ","example":"我们来学“老婆”这个词。","exampleMeaning":"Cùng học từ “老婆”: vợ."},{"id":"w12","term":"挑战","reading":"tiǎozhàn","meaning":"thách","example":"向你挑战战","exampleMeaning":"Thách bạn đấy"},{"id":"w13","term":"秘密","reading":"mìmì","meaning":"bí mật","example":"秘密文件。","exampleMeaning":"Văn kiện bí mật."},{"id":"w14","term":"季","reading":"jì","meaning":"mùa (trong năm)","example":"冬季快來了。","exampleMeaning":"Mùa đông đang tới."},{"id":"w15","term":"失败","reading":"shībài","meaning":"thất bại","example":"我担心他会失败。","exampleMeaning":"Tôi e rằng ông ấy sẽ thất bại."},{"id":"w16","term":"抽","reading":"chōu","meaning":"co","example":"我爸爸每天抽一包烟。","exampleMeaning":"Mỗi ngày bố tôi hút một bao thuốc lá."},{"id":"w17","term":"想象","reading":"xiǎngxiàng","meaning":"tưởng tượng","example":"不难想象。","exampleMeaning":"Dễ dàng tưởng tượng."},{"id":"w18","term":"教授","reading":"jiàoshòu","meaning":"giáo sư","example":"教授微微笑了笑。","exampleMeaning":"Ông giáo sư mỉm cười."},{"id":"w19","term":"吸引","reading":"xīyǐn","meaning":"hấp dẫn, thu hút, lôi cuốn","example":"互相吸引","exampleMeaning":"Hút nhau"},{"id":"w20","term":"顶","reading":"dǐng","meaning":"đội","example":"这顶红帽子很衬她的裙子。","exampleMeaning":"Chiếc mũ đỏ này rất hợp với chiếc váy của cô ấy."}],"sentences":[{"id":"s1","tokens":["冬季","快","来","了"],"reading":"dōngjì kuài lái le","meaning":"Mùa đông đang tới."},{"id":"s2","tokens":["你","是","安全","的"],"reading":"nǐ shì ānquán de","meaning":"Bạn an toàn rồi."},{"id":"s3","tokens":["你","男朋友","真","帅"],"reading":"nǐ nánpéngyou zhēn shuài","meaning":"Bạn trai của bạn đẹp trai quá!"},{"id":"s4","tokens":["教授","微微","笑","了","笑"],"reading":"jiàoshòu wēiwēi xiào le xiào","meaning":"Ông giáo sư mỉm cười."},{"id":"s5","tokens":["我","爸爸","每天","抽","一","包","烟"],"reading":"wǒ bàba měitiān chōu yī bāo yān","meaning":"Mỗi ngày bố tôi hút một bao thuốc lá."}]}
