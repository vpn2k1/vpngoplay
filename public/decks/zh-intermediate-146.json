{"id":"zh-intermediate-146","lang":"zh","course":"zh-intermediate","lesson":146,"draft":true,"level":"HSK4–HSK7-9","title":"Trung cấp · Bài 146","description":"狂欢 · 入侵 · 乃 · 撕 …","words":[{"id":"w01","term":"狂欢","reading":"kuánghuān","meaning":"hoan lạc","example":"狂欢之夜。","exampleMeaning":"Một đêm hoan lạc."},{"id":"w02","term":"入侵","reading":"rùqīn","meaning":"xâm phạm","example":"我们来学“入侵”这个词。","exampleMeaning":"Cùng học từ “入侵”: xâm phạm."},{"id":"w03","term":"乃","reading":"nǎi","meaning":"anh","example":"因山势高峻，乃在山腰休息片时。","exampleMeaning":"Vì dốc núi dựng đứng, thế là đành phải nghỉ ở bên sườn núi một lát."},{"id":"w04","term":"撕","reading":"sī","meaning":"xé, làm rách","example":"把布撕成两块。","exampleMeaning":"Xé vải thành hai miếng."},{"id":"w05","term":"笨蛋","reading":"bèndàn","meaning":"đồ đần","example":"我们来学“笨蛋”这个词。","exampleMeaning":"Cùng học từ “笨蛋”: đồ đần."},{"id":"w06","term":"语气","reading":"yǔqì","meaning":"giọng nói","example":"听他的语气，这事大概有点不妙。","exampleMeaning":"Nghe giọng nói của anh ta, hình như việc này có chút không hay rồi."},{"id":"w07","term":"极度","reading":"jídù","meaning":"quá sức","example":"极度的疲劳。","exampleMeaning":"Mệt quá sức."},{"id":"w08","term":"舱","reading":"cāng","meaning":"khoang","example":"头等舱。","exampleMeaning":"Khoang hạng nhất"},{"id":"w09","term":"处置","reading":"chǔzhì","meaning":"xử lý","example":"处置失当。","exampleMeaning":"Xử lý không thoả đáng."},{"id":"w10","term":"思路","reading":"sīlù","meaning":"dòng suy nghĩ","example":"别打断他的思路。","exampleMeaning":"Đừng làm gián đoạn mạch suy nghĩ của anh ta."},{"id":"w11","term":"念头","reading":"niàntou","meaning":"ý nghĩ","example":"转念头。","exampleMeaning":"Nghĩ lại."},{"id":"w12","term":"每当","reading":"měidāng","meaning":"mỗi khi","example":"我们来学“每当”这个词。","exampleMeaning":"Cùng học từ “每当”: mỗi khi."},{"id":"w13","term":"皇后","reading":"huánghòu","meaning":"hoàng hậu","example":"电影皇后","exampleMeaning":"Ảnh hậu"},{"id":"w14","term":"视线","reading":"shìxiàn","meaning":"đường nhìn","example":"我们来学“视线”这个词。","exampleMeaning":"Cùng học từ “视线”: đường nhìn."},{"id":"w15","term":"间谍","reading":"jiàndié","meaning":"gián điệp","example":"我们来学“间谍”这个词。","exampleMeaning":"Cùng học từ “间谍”: gián điệp."},{"id":"w16","term":"首批","reading":"shǒupī","meaning":"đợt đầu","example":"我们来学“首批”这个词。","exampleMeaning":"Cùng học từ “首批”: đợt đầu."},{"id":"w17","term":"虚","reading":"xū","meaning":"trống, bỏ không, trống rỗng","example":"我很谦虚。","exampleMeaning":"Tôi rất khiêm tốn."},{"id":"w18","term":"壳","reading":"qiào","meaning":"vỏ (trái đất, cây...), vỏ: cấu trúc rỗng và cứng nói chung, mai (cua, rùa)","example":"金蝉脱壳。","exampleMeaning":"Ve sầu lột xác."},{"id":"w19","term":"罪犯","reading":"zuìfàn","meaning":"tội phạm","example":"罪犯们密谋抢劫银行。","exampleMeaning":"Bọn tội phạm đang âm mưu cướp ngân hàng."},{"id":"w20","term":"投降","reading":"tóuxiáng","meaning":"đầu hàng","example":"我们来学“投降”这个词。","exampleMeaning":"Cùng học từ “投降”: đầu hàng."}],"sentences":[{"id":"s1","tokens":["我","很","谦虚"],"reading":"wǒ hěn qiānxū","meaning":"Tôi rất khiêm tốn."},{"id":"s2","tokens":["罪犯","们","密谋","抢劫","银行"],"reading":"zuìfàn men mìmóu qiǎngjié yínháng","meaning":"Bọn tội phạm đang âm mưu cướp ngân hàng."},{"id":"s3","tokens":["可惜","这","是","真","的"],"reading":"kěxī zhè shì zhēn de","meaning":"Tiếc rằng cái đó là sự thật."},{"id":"s4","tokens":["哦","有","一","只","蝴蝶"],"reading":"ó yǒu yī zhī húdié","meaning":"Ô kìa, con bươm bướm!"},{"id":"s5","tokens":["你","想","买","些","什么"],"reading":"nǐ xiǎng mǎi xiē shénme","meaning":"Anh muốn mua những gì?"}]}
