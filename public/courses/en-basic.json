{"id":"en-basic","lang":"en","level":"A1–B1","title":"Cơ bản (A1–B1)","description":"20 từ · 1 bài","words":[{"id":"en-basic-001:w01","term":"point","reading":"/pɔɪnt/","meaning":"điểm, ý chính","example":"That is a good point.","exampleMeaning":"Đó là một ý hay.","srsKey":"en-basic-001:w01"},{"id":"en-basic-001:w02","term":"February","reading":"/ˈfebjueri/","meaning":"tháng Hai","example":"My birthday is in February.","exampleMeaning":"Sinh nhật tôi vào tháng Hai.","srsKey":"en-basic-001:w02"},{"id":"en-basic-001:w03","term":"gray","reading":"/ɡreɪ/","meaning":"màu xám","example":"Gray is my favorite color.","exampleMeaning":"Màu xám là màu tôi thích nhất.","srsKey":"en-basic-001:w03"},{"id":"en-basic-001:w04","term":"that","reading":"/ðæt/","meaning":"rằng","example":"I think that she is right.","exampleMeaning":"Tôi nghĩ rằng cô ấy đúng.","srsKey":"en-basic-001:w04"},{"id":"en-basic-001:w05","term":"camera","reading":"/ˈkæmərə/","meaning":"máy ảnh","emoji":"📷","example":"I bought a new camera.","exampleMeaning":"Tôi đã mua một chiếc máy ảnh mới.","srsKey":"en-basic-001:w05"},{"id":"en-basic-001:w06","term":"message","reading":"/ˈmesɪdʒ/","meaning":"tin nhắn, lời nhắn","emoji":"💬","example":"Please leave a message.","exampleMeaning":"Vui lòng để lại lời nhắn.","srsKey":"en-basic-001:w06"},{"id":"en-basic-001:w07","term":"which","reading":"/wɪtʃ/","meaning":"cái nào, nào","example":"Which bag is yours?","exampleMeaning":"Túi nào là của bạn?","srsKey":"en-basic-001:w07"},{"id":"en-basic-001:w08","term":"television","reading":"/ˈtelɪvɪʒn/","meaning":"tivi, truyền hình","emoji":"📺","example":"We watch television after dinner.","exampleMeaning":"Chúng tôi xem tivi sau bữa tối.","srsKey":"en-basic-001:w08"},{"id":"en-basic-001:w09","term":"change","reading":"/tʃeɪndʒ/","meaning":"sự thay đổi, tiền thừa","example":"Here is your change.","exampleMeaning":"Đây là tiền thừa của bạn.","srsKey":"en-basic-001:w09"},{"id":"en-basic-001:w10","term":"sight","reading":"/saɪt/","meaning":"thị lực, cảnh tượng","example":"My grandfather has poor sight.","exampleMeaning":"Ông tôi có thị lực kém.","srsKey":"en-basic-001:w10"},{"id":"en-basic-001:w11","term":"church","reading":"/tʃɜːrtʃ/","meaning":"nhà thờ","emoji":"⛪","example":"The church is next to the park.","exampleMeaning":"Nhà thờ ở cạnh công viên.","srsKey":"en-basic-001:w11"},{"id":"en-basic-001:w12","term":"girl","reading":"/ɡɜːrl/","meaning":"cô gái, bé gái","emoji":"👧","example":"The girl is reading a book.","exampleMeaning":"Cô bé đang đọc sách.","srsKey":"en-basic-001:w12"},{"id":"en-basic-001:w13","term":"knife","reading":"/naɪf/","meaning":"con dao","emoji":"🔪","example":"Be careful with that knife.","exampleMeaning":"Cẩn thận với con dao đó.","srsKey":"en-basic-001:w13"},{"id":"en-basic-001:w14","term":"music","reading":"/ˈmjuːzɪk/","meaning":"âm nhạc, nhạc","emoji":"🎵","example":"I listen to music every day.","exampleMeaning":"Tôi nghe nhạc mỗi ngày.","srsKey":"en-basic-001:w14"},{"id":"en-basic-001:w15","term":"CD","reading":"/ˌsiː ˈdiː/","meaning":"đĩa CD","emoji":"💿","example":"She gave me a CD for my birthday.","exampleMeaning":"Cô ấy tặng tôi một đĩa CD nhân dịp sinh nhật.","srsKey":"en-basic-001:w15"},{"id":"en-basic-001:w16","term":"Miss","reading":"/mɪs/","meaning":"cô (cách gọi phụ nữ chưa chồng)","example":"Miss Lan is our teacher.","exampleMeaning":"Cô Lan là giáo viên của chúng tôi.","srsKey":"en-basic-001:w16"},{"id":"en-basic-001:w17","term":"sorry","reading":"/ˈsɑːri/","meaning":"xin lỗi, tiếc","example":"I am sorry I am late.","exampleMeaning":"Xin lỗi, tôi đến muộn.","srsKey":"en-basic-001:w17"},{"id":"en-basic-001:w18","term":"at","reading":"/æt/","meaning":"ở, tại, lúc","example":"I will meet you at the station.","exampleMeaning":"Tôi sẽ gặp bạn ở nhà ga.","srsKey":"en-basic-001:w18"},{"id":"en-basic-001:w19","term":"medicine","reading":"/ˈmedɪsn/","meaning":"thuốc, y học","emoji":"💊","example":"Take this medicine after meals.","exampleMeaning":"Uống thuốc này sau bữa ăn.","srsKey":"en-basic-001:w19"},{"id":"en-basic-001:w20","term":"phone","reading":"/foʊn/","meaning":"gọi điện thoại","emoji":"📞","example":"I will phone you tonight.","exampleMeaning":"Tối nay tôi sẽ gọi điện cho bạn.","srsKey":"en-basic-001:w20"}],"sentences":[{"id":"en-basic-001:s1","tokens":["I","will","phone","you","at","six"],"meaning":"Tôi sẽ gọi điện cho bạn lúc sáu giờ."},{"id":"en-basic-001:s2","tokens":["The","girl","likes","music"],"meaning":"Cô bé thích âm nhạc."},{"id":"en-basic-001:s3","tokens":["Which","camera","is","yours"],"meaning":"Cái máy ảnh nào là của bạn?"},{"id":"en-basic-001:s4","tokens":["Sorry","I","did","not","see","your","message"],"meaning":"Xin lỗi, tôi không thấy tin nhắn của bạn."},{"id":"en-basic-001:s5","tokens":["The","church","is","very","old"],"meaning":"Nhà thờ rất cổ."}],"lessons":[{"id":"en-basic-001","lesson":1,"preview":["point","February","gray"],"wordCount":20}]}
