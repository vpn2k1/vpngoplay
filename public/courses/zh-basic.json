{"id":"zh-basic","lang":"zh","level":"HSK1–HSK4","title":"Cơ bản (HSK1–HSK4)","description":"20 từ · 1 bài","words":[{"id":"zh-basic-001:w01","term":"的","reading":"de","meaning":"của (trợ từ sở hữu)","example":"这是我的书。","exampleMeaning":"Đây là sách của tôi.","srsKey":"zh-basic-001:w01"},{"id":"zh-basic-001:w02","term":"了","reading":"le","meaning":"rồi, đã","example":"我吃饭了。","exampleMeaning":"Tôi ăn cơm rồi.","srsKey":"zh-basic-001:w02"},{"id":"zh-basic-001:w03","term":"我","reading":"wǒ","meaning":"tôi, tớ","example":"我是学生。","exampleMeaning":"Tôi là học sinh.","srsKey":"zh-basic-001:w03"},{"id":"zh-basic-001:w04","term":"是","reading":"shì","meaning":"là, đúng","example":"他是老师。","exampleMeaning":"Anh ấy là giáo viên.","srsKey":"zh-basic-001:w04"},{"id":"zh-basic-001:w05","term":"你","reading":"nǐ","meaning":"bạn","example":"你好吗？","exampleMeaning":"Bạn khỏe không?","srsKey":"zh-basic-001:w05"},{"id":"zh-basic-001:w06","term":"在","reading":"zài","meaning":"ở, đang","example":"我在家。","exampleMeaning":"Tôi ở nhà.","srsKey":"zh-basic-001:w06"},{"id":"zh-basic-001:w07","term":"不","reading":"bù","meaning":"không","example":"我不喝茶。","exampleMeaning":"Tôi không uống trà.","srsKey":"zh-basic-001:w07"},{"id":"zh-basic-001:w08","term":"有","reading":"yǒu","meaning":"có","example":"我有一个哥哥。","exampleMeaning":"Tôi có một anh trai.","srsKey":"zh-basic-001:w08"},{"id":"zh-basic-001:w09","term":"他","reading":"tā","meaning":"anh ấy, ông ấy","example":"他很高。","exampleMeaning":"Anh ấy rất cao.","srsKey":"zh-basic-001:w09"},{"id":"zh-basic-001:w10","term":"这","reading":"zhè","meaning":"này, đây","example":"这个很好吃。","exampleMeaning":"Cái này rất ngon.","srsKey":"zh-basic-001:w10"},{"id":"zh-basic-001:w11","term":"就","reading":"jiù","meaning":"thì, ngay, liền","example":"我马上就来。","exampleMeaning":"Tôi đến ngay.","srsKey":"zh-basic-001:w11"},{"id":"zh-basic-001:w12","term":"个","reading":"gè","meaning":"cái, chiếc (lượng từ)","example":"我买了三个苹果。","exampleMeaning":"Tôi đã mua ba quả táo.","srsKey":"zh