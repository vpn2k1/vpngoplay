# Supabase (optional): accounts, cloud progress and leaderboards.
# Project Settings → API: the project URL and the publishable (anon) key — both are safe in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Claude API key for `npm run vocab:enrich` (build-time only; never prefix with VITE_).
ANTHROPIC_API_KEY=

# Google Cloud Text-to-Speech key for `npm run audio` (build-time only; never prefix with VITE_).
GOOGLE_TTS_API_KEY=

# Optional: where the generated clips are served from, if not from this app (e.g. a Cloudflare R2 bucket URL).
VITE_AUDIO_BASE_URL=
